#!/usr/bin/env python3
"""nix-darwin の操縦席と止まったものの知らせを読み、朝の定期確認の要約を Markdown で出す。読むだけ。

拾うのは 3 種類（C1 確認日が来たタスク・C2 動きの無いタスク・C3 止まったもの）。深田さんの番のカードは窓に出ているので拾わない。
何も無ければ何も出さない（呼び出し側はそれで NO_REPLY にする）。モデルは呼ばない。
ほかの案件は、その案件の操縦席と Bot ができたときにその Bot が同じ形で持つので、ここでは nix-darwin の操縦席だけを読む（R154）。
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import date, datetime, timedelta, timezone

JST = timezone(timedelta(hours=9))
HERE = os.path.dirname(os.path.realpath(__file__))
COCKPIT = os.environ.get("MORNING_CHECK_COCKPIT") or os.path.expanduser("~/.config/nix-darwin/.orca/cockpit.json")
COCKPIT_DIR = os.environ.get("COCKPIT_DIR") or os.path.expanduser("~/Library/Application Support/cockpit")
# 窓と同じ判定。worker の記録があるタスクの状態は Orca の Dispatch から決まるので、cockpit.json の手書きの state を信じない
STATE = os.environ.get("COCKPIT_STATE") or os.path.join(HERE, "..", "orca", "plugins", "cockpit", "window", "state.ts")
# タスクの確認日の欄（2026-12-04 の形）。欄の名前は窓の版 3 で決まるので、ここだけを差し替える
CHECK_ON = "check_on"
STALE = timedelta(hours=72)
STALE_STATES = {"idle", "wait"}
LABEL = {"idle": "未着手", "wait": "待機", "run": "作業中", "stop": "停止", "ok": "完了"}


def load(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


def parse_at(s):
    if not isinstance(s, str):
        return None
    try:
        # Python 3.9 の fromisoformat は末尾の Z を読めない
        d = datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None
    return d if d.tzinfo else d.replace(tzinfo=JST)


def judged(root):
    """state.ts の判定済みのタスクの状態（id → state）。読めなければ None。"""
    try:
        done = subprocess.run(["node", STATE, root], capture_output=True, text=True, timeout=60)
        r = json.loads(done.stdout) if done.returncode == 0 else None
        # Orca を読めないと state.ts は orca: "error" で正常終了し、手書きの state で判定した結果を返す
        return {t["id"]: t["state"] for t in r["tasks"]} if r and r.get("orca") != "error" else None
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        return None


def last_moves(c):
    """タスクごとの最後の動き。タスクの done[].at・waiting_since と、そのタスクに結び付いたカードと依頼の時刻の最新。"""
    moves = {}

    def put(tid, s):
        d = parse_at(s)
        if d and (tid not in moves or d > moves[tid]):
            moves[tid] = d

    for t in c.get("tasks") or []:
        for x in t.get("done") or []:
            if isinstance(x, dict):
                put(t.get("id"), x.get("at"))
        put(t.get("id"), t.get("waiting_since"))
    for key, stamps in (("cards", ("at", "created_at", "resolved_at")), ("requests", ("at", "done_at"))):
        for x in c.get(key) or []:
            for tid in x.get("tasks") or []:
                for k in stamps:
                    put(tid, x.get(k))
    return moves


def md(d):
    return f"{d.month}/{d.day}"


def check(path, alerts_path, now):
    root = os.path.dirname(os.path.dirname(os.path.abspath(path)))
    today = now.astimezone(JST).date()
    try:
        c = load(path)
        states = judged(root)
        unread = [] if states is not None else [f"- 状態の判定が失敗（node {STATE} {root} で理由を確認）。操縦席の手書きの state で判定した"]
    except (OSError, ValueError) as e:
        # 操縦席が読めなくても、止まったものの知らせは別のファイルなので出す
        c, states, unread = {}, {}, [f"- 操縦席を読めない（{path}: {e}）"]
    moves = last_moves(c)

    due, stale = [], []
    for t in c.get("tasks") or []:
        state = (states or {}).get(t.get("id"), t.get("state"))
        if state == "ok":
            continue
        name = f"{t.get('title')}（{t.get('id')}、{LABEL.get(state, state)}"
        raw = t.get(CHECK_ON)
        on = None
        if raw:
            try:
                on = date.fromisoformat(str(raw))
            except ValueError:
                due.append(f"- {name}、確認日を読めない：{raw}）")
                continue
            if on <= today:
                due.append(f"- {name}、確認日{md(on)}）：{t.get('next', '')}")
                continue
        # 先の確認日が入ったタスクは、その日まで待つと決めてあるので動きが無くても拾わない
        if on or state not in STALE_STATES:
            continue
        last = moves.get(t.get("id"))
        if last is None:
            stale.append(f"- {name}、動きの記録なし）：{t.get('waiting_on') or t.get('next', '')}")
        elif now - last >= STALE:
            stale.append(f"- {name}、最後の動き{md(last.astimezone(JST))} {last.astimezone(JST):%H:%M}）：{t.get('waiting_on') or t.get('next', '')}")

    alerts = []
    if os.path.exists(alerts_path):
        try:
            alerts = load(alerts_path).get("alerts") or []
        except (OSError, ValueError, AttributeError) as e:
            unread.append(f"- 止まったものの知らせを読めない（{alerts_path}: {e}）")
    # root の無い知らせ（launchd の定時ジョブ・窓のサーバー）はハーネスの分。ほかのワークスペースの分はその案件の Bot が持つ
    mine = [f"- {a.get('text')}" for a in alerts if not a.get("root") or os.path.realpath(a["root"]) == os.path.realpath(root)]

    return [("確認日が来たタスク", due), ("動きの無いタスク（未着手・待機のまま3日以上）", stale), ("止まったもの", mine), ("読めなかったもの", unread)]


def render(sections, now):
    body = [f"### {head}\n" + "\n".join(lines) for head, lines in sections if lines]
    if not body:
        return ""
    return f"朝の定期確認（{md(now)} {now:%H:%M}時点）\n\n" + "\n\n".join(body) + "\n"


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--cockpit", default=COCKPIT, help="読む操縦席（既定は nix-darwin の .orca/cockpit.json）")
    p.add_argument("--now", help="今の時刻（ISO 8601。テスト用）")
    a = p.parse_args(argv)
    now = (parse_at(a.now) if a.now else datetime.now(JST)).astimezone(JST)
    try:
        sections = check(a.cockpit, os.path.join(COCKPIT_DIR, "alerts.json"), now)
    except Exception as e:
        # 空の出力は「何も無い」として送られないので、想定外の形で落ちたことは本文で知らせる
        sections = [("読めなかったもの", [f"- 朝の定期確認が失敗（{type(e).__name__}: {e}）"])]
    sys.stdout.write(render(sections, now))


if __name__ == "__main__":
    main()
