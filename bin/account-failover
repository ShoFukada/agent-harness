#!/usr/bin/env python3
"""今の Claude の席が利用枠の上限に当たったら、優先度が高く空いている席へ切り替え、Orca の中で動く claude を全部、今の席へ移す。

launchd が 1 分おきに 1 回ずつ起こす。モデルは呼ばず、トークンにも触らない（Orca の CLI が返す使用量と席の一覧、claude のプロセスの
引数と環境変数だけを読む）。切り替えは `orca account select` に任せる。Orca の設定「アカウントを切り替えたとき端末の Claude を」は
keep（端末に何もしない）にしておく前提で、claude のプロセスがどの席（CLAUDE_CONFIG_DIR）で動いているかを毎回数え、
今の席と違うものを移す（R205）。自動の切り替えのあとも、人が手で切り替えたあとも同じ処理が拾う。
- 端末（worker を含む）: 入力待ちになったら /exit を送り、同じ端末で同じ引数・同じ会話のまま今の席で起こし直す
- チャット（窓口・担当）: 作業中のターンが無いか上限で止まっていれば裏の claude を止める。Orca は次の発言で今の席の claude を起こす
今の席と違うプロセスが無ければ、プロセスの一覧を 1 回読んで終える。移せないものは名前・理由・次に要る操作を窓の帯に出す。
知らせは通知と、stallwatch が窓の帯に合流させる failover.json に出す。
"""

import argparse
import ctypes
import fcntl
import importlib.util
import json
import os
import re
import shlex
import signal
import struct
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader

_here = os.path.dirname(os.path.realpath(__file__))
_loader = SourceFileLoader("stallwatch", os.path.join(_here, "stallwatch"))
sw = importlib.util.module_from_spec(importlib.util.spec_from_loader("stallwatch", _loader))
_loader.exec_module(sw)

HOME = sw.HOME
STATE = os.path.join(HOME, "failover-state.json")
STATUS = os.path.join(HOME, "failover.json")
HISTORY = os.path.join(HOME, "failover-history.jsonl")
TELLS = os.path.join(HOME, "failover-tells.json")
MIN = 60_000
# 今の席の使用量がこれより古ければ判断しない（Orca は今の席を 2 分ほどおきに読み直す）。
FRESH_MS = 30 * MIN
# 切り替えたあと、Orca が新しい席の使用量を読むまで次の切り替えをしない。
GAP_MS = 10 * MIN
# この時間にこれより多く切り替えたら、往復していると見なして止める。
FLAP_WINDOW_MS = 6 * 60 * MIN
FLAP_MAX = 6
# 戻る時刻が分からない窓は、この時間は戻らないと見なす。
UNKNOWN_BACK_MS = 60 * MIN
BAND_MS = 30 * MIN
# 使用量の分からない席へ切り替えたあと、Orca がこの時間たっても読めなければ、上限でも切り替えられないと知らせる。
BLIND_MS = 15 * MIN
WINDOWS = ("session", "weekly")
# 端末の画面に出る Claude Code の上限の 1 行。stallwatch の LIMIT は「rate limit」も拾い、開発サーバーのログにも当たるので狭める。
TERMINAL_LIMIT = re.compile(r"(?i)\b(?:hit|reached) your [\w -]*limit\b|usage limit")
SHOWN = {"full": "上限", "free": "空き", "unknown": "使用量不明"}
# Orca の使用量の失敗のうち、席のログインが切れていることを示すもの。stale-token は「しばらく動いていない席のトークンが古いだけで、
# 次に Claude が動けば更新される」（Orca の説明）なので入れない。
LOGIN_NEEDED = {"missing-credentials"}

# 古い席のプロセスを移す処理
EXIT_WAIT_S = int(os.environ.get("FAILOVER_EXIT_WAIT_S") or 30)
APPEAR_WAIT_S = int(os.environ.get("FAILOVER_APPEAR_WAIT_S") or 30)
STOP_WAIT_S = int(os.environ.get("FAILOVER_STOP_WAIT_S") or 15)
# 作業中のまま手が空かないプロセスを、移そうと試し続ける時間。過ぎたら諦めて名指しする。
GIVE_UP_MS = 6 * 60 * MIN
# 同じ段階でこの回数うまくいかなければ諦めて名指しする。
MAX_TRIES = 3
# 端末の今のターンの印。Orca の agent list の state がこれなら入力待ちでない。
BUSY_STATES = {"working", "blocked", "waiting"}
CONVERGE_ID = "failover:converge:"
NUDGE = "[account-failover] 席の切り替えで、claude を今の席（%s）で起こし直しました。利用枠の上限で止まったところから続けてください。"
CHAT_NOTICE = "[account-failover] 席の切り替えで「%s」の裏の claude を止めた。Dispatch は生きているので立て直さない（次のメッセージで今の席の claude が起きる）"
CHAT_RESUME = "[account-failover] 席の切り替えで起こし直した。バックグラウンドの監視は止まったので、要るものは張り直す。利用枠の上限で止まったところから続けて"
UUID = r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"


def back_at(rl, now):
    """使用量（Orca の rateLimits の 1 席分）が上限なら戻る時刻（ms）、上限でなければ None。fableWeekly は見ない（主に opus を使うため）。"""
    full = [w for w in (rl.get(k) for k in WINDOWS)
            if w and (w.get("usedPercent") or 0) >= 100 and not (w.get("resetsAt") and w["resetsAt"] <= now)]
    if not full:
        return None
    return max(w.get("resetsAt") or now + UNKNOWN_BACK_MS for w in full)


def seat_states(claude, limits, now):
    """席の id → {"email", "state": full|free|unknown, "back", "updatedAt"}。今の席は status ok で新しい値のときだけ判断する。"""
    readings = {a["accountId"]: a.get("rateLimits") or {} for a in limits.get("inactiveClaudeAccounts") or []}
    active = claude.get("activeAccountId")
    cur = limits.get("claude") or {}
    if ((cur.get("usageMetadata") or {}).get("readingAccount") or {}).get("accountId") == active:
        readings[active] = cur
    out = {}
    for acc in claude.get("accounts") or []:
        rl = readings.get(acc["id"]) or {}
        fresh = rl.get("status") == "ok" and (acc["id"] != active or now - (rl.get("updatedAt") or 0) <= FRESH_MS)
        back = back_at(rl, now) if fresh else None
        out[acc["id"]] = {"email": acc.get("email"), "state": "unknown" if not fresh else "full" if back else "free",
                          "back": back, "updatedAt": rl.get("updatedAt") or 0, "home": acc.get("home"),
                          "failure": (rl.get("usageMetadata") or {}).get("failureKind")}
    return out


def unusable(order, active, seats):
    """行き先にできない席の id → 理由。ログインが切れている席と、起こすと確認の画面で止まる席（移した端末が止まる）。"""
    out = {}
    for sid in order:
        s = seats.get(sid)
        if sid == active or not s:
            continue
        if s["failure"] in LOGIN_NEEDED:
            out[sid] = "ログインが要る（Orca のアカウントの画面でログインし直す）"
            continue
        screens = sw.seat_screens(s["home"])
        if screens:
            out[sid] = "claude を起こすと「%s」で止まる（その席で一度 claude を対話で起こして答える）" % "」「".join(screens)
    return out


def choose(order, active, seats, left, now, blocked=()):
    """行き先の席の id。優先度順に、分かっている空きを先に、無ければ使用量の分からない席を選ぶ。
    上限で離れた席は、戻る時刻を過ぎるか、離れたあとに Orca が上限でないと読むまで選ばない。blocked の席は選ばない。"""
    def usable(sid):
        s = seats[sid]
        gone = left.get(sid)
        if gone and now < gone["back"] and not (s["state"] == "free" and s["updatedAt"] > gone["at"]):
            return False
        return s["state"] != "full"
    cands = [sid for sid in order if sid != active and sid in seats and sid not in blocked and usable(sid)]
    return next((s for s in cands if seats[s]["state"] == "free"), None) or next(iter(cands), None)


def earliest_back(order, active, seats, left, now):
    """全席が上限のとき、最初に戻る席と時刻。"""
    backs = []
    for sid in order:
        s = seats.get(sid)
        if not s:
            continue
        b = s["back"] or (left.get(sid) or {}).get("back")
        if b:
            backs.append((b, s["email"]))
    return min(backs) if backs else None


def clock(ms, now):
    return sw.clock(ms, now)


def orca_ok(*args):
    # stallwatch.orca() は JSON でない出力の先頭を返すことがあり、端末の画面の中身が混ざりうるので、通知と記録には載せない。
    res, _err, _ = sw.orca(*args)
    if res is None:
        raise RuntimeError("orca %s が失敗した" % " ".join(args[:2]))
    return res


# ---------- 実物の数え上げ ----------
# macOS の sysctl。ps の表示は引数の境界を失い、`Application Support` の空白や JSON の --settings が壊れるので、
# KERN_PROCARGS2 で引数と環境変数を 1 つずつ読む。kinfo_proc の大きさと位置は arm64・x86_64 の macOS で同じ。
CTL_KERN, KERN_PROC, KERN_PROC_ALL, KERN_PROCARGS2 = 1, 14, 0, 49
KINFO_SIZE, PID_AT, COMM_AT, PPID_AT = 648, 40, 243, 560
# nix の claude は exec で .claude-wrapped に替わり、comm はそちらになる。
CLAUDE_COMMS = {"claude", ".claude-wrapped"}


def _sysctl(mib):
    libc = ctypes.CDLL(None, use_errno=True)
    arr = (ctypes.c_int * len(mib))(*mib)
    for _ in range(5):
        size = ctypes.c_size_t(0)
        if libc.sysctl(arr, len(mib), None, ctypes.byref(size), None, 0) != 0:
            return None
        size.value += size.value // 8  # 読むまでに増えたプロセスの分
        buf = ctypes.create_string_buffer(size.value)
        if libc.sysctl(arr, len(mib), buf, ctypes.byref(size), None, 0) == 0:
            return buf.raw[:size.value]
        if ctypes.get_errno() != 12:  # ENOMEM のときだけ読み直す
            return None
    return None


def _fake():
    """試験の偽のプロセスの一覧（FAILOVER_PROCESSES）。[{"pid", "ppid", "comm", "argv", "env"}]。"""
    path = os.environ.get("FAILOVER_PROCESSES")
    return sw.load(path, []) if path else None


def process_table():
    """pid → (親の pid, comm)。"""
    fake = _fake()
    if fake is not None:
        return {p["pid"]: (p["ppid"], p["comm"]) for p in fake}
    raw = _sysctl([CTL_KERN, KERN_PROC, KERN_PROC_ALL, 0])
    if raw is None or len(raw) % KINFO_SIZE:
        raise RuntimeError("プロセスの一覧（sysctl KERN_PROC_ALL）を読めない")
    out = {}
    for off in range(0, len(raw), KINFO_SIZE):
        pid = struct.unpack_from("i", raw, off + PID_AT)[0]
        comm = raw[off + COMM_AT:off + COMM_AT + 17].split(b"\0")[0].decode("utf-8", "replace")
        out[pid] = (struct.unpack_from("i", raw, off + PPID_AT)[0], comm)
    return out


def proc_args(pid):
    """プロセスの (引数の一覧, 環境変数)。読めなければ None（終わったか、ほかのユーザーのプロセス）。"""
    fake = _fake()
    if fake is not None:
        p = next((x for x in fake if x["pid"] == pid), None)
        return (p["argv"], p["env"]) if p else None
    raw = _sysctl([CTL_KERN, KERN_PROCARGS2, pid])
    if not raw or len(raw) < 4:
        return None
    argc = struct.unpack_from("i", raw, 0)[0]
    _exe, _, rest = raw[4:].partition(b"\0")
    parts = rest.lstrip(b"\0").split(b"\0")
    text = [p.decode("utf-8", "replace") for p in parts]
    env = dict(p.split("=", 1) for p in text[argc:] if "=" in p)
    return text[:argc], env


def alive(pid, key):
    """pid の claude がまだ同じ端末・チャットのものとして動いているか（pid が別のプロセスに使い回されても取り違えない）。"""
    return any(r["pid"] == pid and key_of(r) == key for r in inventory())


def opt(argv, *names):
    """引数の一覧から、names のどれかの値（`--x v` と `--x=v`）。"""
    for i, a in enumerate(argv):
        for n in names:
            if a == n and i + 1 < len(argv):
                return argv[i + 1]
            if a.startswith(n + "=") and n.startswith("--"):
                return a[len(n) + 1:]
    return None


def arg_session(argv):
    sid = opt(argv, "--resume", "-r", "--session-id")
    return sid if sid and re.fullmatch(UUID, sid) else None


def settings_file(argv):
    """--settings のうち、設定のファイル（worker の設定）を指すもの。Orca は claude に JSON を直に渡す
    （`--settings {"fastMode":false}`）ことがあり、それは worker の設定ではない。"""
    v = opt(argv, "--settings")
    return v if v and v[0] in "/~" else None


def relaunch_args(argv):
    """起こし直すときに引き継ぐ引数。会話を選ぶもの（--resume・--continue・--session-id・--fork-session）は外し、呼ぶ側が --resume <会話 id> を足す。"""
    out, skip = [], False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a in ("--resume", "-r"):
            # --resume は値を取らずに会話の選び直しの画面を開くこともある
            skip = i + 1 < len(argv) and bool(re.fullmatch(UUID, argv[i + 1]))
            continue
        if a == "--session-id":
            skip = True
            continue
        if a in ("--continue", "-c", "--fork-session") or a.startswith(("--resume=", "--session-id=")):
            continue
        out.append(a)
    return out


def inventory():
    """Orca の中で動く claude のプロセス: [{"pid", "seat"(CLAUDE_CONFIG_DIR の実のパス or None), "kind"(terminal|chat), "handle", "chat",
    "argv"(先頭を除く), "ws"(ORCA_WORKER_SETTINGS), "session", "cwd", "busy"}]。
    祖先に claude がいるもの（ツールや hook が起こした子の claude。環境変数を受け継ぐので、親と同じ handle を持つ）と、
    Orca の印（端末・担当の ORCA_TERMINAL_HANDLE、チャットの ORCA_AGENT_SESSION_ID）が無いもの（Orca の外）は除く。
    窓口のチャットは ORCA_TERMINAL_HANDLE を持たない（2026-11-23 に KERN_PROCARGS2 で確かめた）ので、チャットの印でも数える。
    会話 id は claude が動いている間に書く <席>/sessions/<pid>.json、無ければ引数の --resume・--session-id。"""
    table = process_table()
    out = []
    for pid, (ppid, comm) in sorted(table.items()):
        if comm not in CLAUDE_COMMS:
            continue
        up, seen = ppid, set()
        while up > 1 and up not in seen and up in table:
            seen.add(up)
            if table[up][1] in CLAUDE_COMMS:
                break
            up = table[up][0]
        else:
            got = proc_args(pid)
            if not got:
                continue
            argv, env = got
            handle, chat = env.get("ORCA_TERMINAL_HANDLE") or None, env.get("ORCA_AGENT_SESSION_ID") or None
            if not handle and not chat:
                continue
            home = env.get("CLAUDE_CONFIG_DIR") or None
            sess = sw.load(os.path.join(home or os.path.expanduser("~/.claude"), "sessions", "%d.json" % pid), None)
            sess = sess if isinstance(sess, dict) else {}
            sid = str(sess.get("sessionId") or "")
            out.append({"pid": pid, "seat": seat_key(home), "home": home,
                        "kind": "chat" if chat or str(handle).startswith("structworker_") else "terminal",
                        "handle": handle, "chat": chat, "argv": argv[1:], "ws": env.get("ORCA_WORKER_SETTINGS"),
                        "session": sid if re.fullmatch(UUID, sid) else arg_session(argv[1:]),
                        "cwd": sess.get("cwd"), "status": sess.get("status"), "busy": sess.get("status") == "busy"})
    return out


def seat_key(home):
    return os.path.realpath(home) if home else None


def key_of(row):
    return "chat:" + row["chat"] if row["kind"] == "chat" and row["chat"] else row["handle"]


def last_reply(row):
    """プロセスの会話の、会話記録の最後の assistant の (時刻, 本文)。そのあとに入力（user）があれば "input"、読めなければ None。"""
    if not row.get("session") or not row.get("cwd"):
        return None
    name = re.sub(r"[^A-Za-z0-9]", "-", row["cwd"].rstrip("/"))
    homes = [os.path.join(row.get("home") or os.path.expanduser("~/.claude"), "projects")] + sw.claude_projects()
    for proj in homes:
        path = os.path.join(proj, name, row["session"] + ".jsonl")
        try:
            with open(path, "rb") as fh:
                fh.seek(max(0, os.path.getsize(path) - sw.TRANSCRIPT_TAIL))
                lines = fh.read().decode("utf-8", "replace").splitlines()
        except OSError:
            continue
        for line in reversed(lines):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict) and e.get("type") == "user":
                return "input"  # 最後の応答より新しい入力がある（ターンの途中か、答えを待っている）
            if isinstance(e, dict) and e.get("type") == "assistant":
                content = (e.get("message") or {}).get("content")
                text = content if isinstance(content, str) else "".join(
                    c.get("text") or "" for c in content or [] if isinstance(c, dict) and c.get("type") == "text")
                return sw.ms_of(e.get("timestamp")) or 0, text
        return None
    return None


def limited(row, preview=""):
    """会話の最後が利用枠の上限の 1 行で止まっているか。会話記録を読めればそれだけで決め（画面には上限のあとに続けた作業の前の行が残る）、
    読めないときだけ端末の画面の上限の 1 行を見る。"""
    reply = last_reply(row)
    if reply == "input":
        return False
    if reply:
        return (sw.stop_cause(reply[1], reply[0], sw.now_ms()) or "").startswith("利用枠の上限")
    return bool(TERMINAL_LIMIT.search(preview or ""))


def screen(handle):
    """端末の今の画面の最後の行。読めなければ None（空の画面と分ける）。"""
    res = sw.orca("terminal", "read", "--terminal", handle, "--screen")[0]
    if res is None:
        return None
    return [l.rstrip() for l in (res.get("terminal") or {}).get("tail") or [] if l.strip()][-sw.SCREEN_LINES:]


def stop(pid):
    """チャットの裏の claude に SIGTERM を送る。"""
    cmd = os.environ.get("FAILOVER_KILL")
    if cmd:
        subprocess.run([cmd, str(pid)], check=True, timeout=30)
        return
    if _fake() is not None:
        raise RuntimeError("偽のプロセスの一覧の pid に本物の signal は送らない（FAILOVER_KILL が要る）")
    os.kill(pid, signal.SIGTERM)


def worker_rows():
    """orchestration の Dispatch を新しい順にすべて（1 ページ 100 件をページ送りで）。"""
    rows, cursor = [], None
    for _ in range(20):
        page = orca_ok("orchestration", "worker-list", "--limit", "100", *(["--cursor", cursor] if cursor else []))
        if not isinstance(page.get("workers"), list):
            raise RuntimeError("orca orchestration worker-list の形が変わった（workers が無い）")
        rows += page["workers"]
        cursor = page.get("nextCursor")
        if not cursor:
            return rows
    raise RuntimeError("orca orchestration worker-list が 2000 件を超えた")


def pane(t):
    # 窓に出ていない端末は tabId・leafId が `pty:<ptyId>` になり、元の枠は recordedPaneKey に残る（agent list の paneKey もこちら）。
    return t.get("recordedPaneKey") or "%s:%s" % (t.get("tabId"), t.get("leafId"))


def tell(sender, subject, body, to=None):
    """Orca の orchestration の知らせを送る（to を省くと送り主の worker の coordinator へ）。送れなければ残し、次の回に送り直す（flush_tells）。"""
    if send_tell({"from": sender, "subject": subject, "body": body, "to": to}):
        return True
    sw.save(TELLS, sw.load(TELLS, []) + [{"from": sender, "subject": subject, "body": body, "to": to, "at": sw.now_ms()}])
    return False


def send_tell(m):
    return sw.orca("orchestration", "send", "--from", m["from"], *(["--to", m["to"]] if m.get("to") else []), "--type", "status",
                   "--subject", m["subject"], "--body", m["body"])[0] is not None


def flush_tells(now):
    """送れなかった知らせを送り直す。1 日たっても送れなければ捨てる。"""
    left = []
    for m in sw.load(TELLS, []):
        if now - m["at"] < 24 * 60 * MIN and not send_tell(m):
            left.append(m)
    sw.save(TELLS, left)


def relaunch_command(rec, home):
    """同じ端末で同じ会話を今の席で起こし直す行。引数は 1 つずつ引用する（`Application Support` の空白・JSON の --settings）。"""
    env = ["CLAUDE_CONFIG_DIR=" + home] if home else ["-u", "CLAUDE_CONFIG_DIR"]
    # sandbox の外で動く claude/bin の入口は denyRead を $ORCA_WORKER_SETTINGS から読むので、元のプロセスの値をそのまま渡す
    env += ["ORCA_WORKER_SETTINGS=" + rec["ws"]] if rec.get("ws") else []
    return shlex.join(["env", *env, "claude", *relaunch_args(rec["argv"]), "--resume", rec["session"]])


class Mover:
    """1 回の実行で、古い席のプロセスを今の席へ移す。移しかけの記録は failover-state.json の moves に、
    移せないものは converge に残す（途中で落ちても、次の回が記録の段階から続ける）。"""

    def __init__(self, home, email, emails, now, dry_run):
        self.home, self.target, self.email, self.emails, self.now, self.dry_run = home, seat_key(home), email, emails, now, dry_run
        self.state = sw.load(STATE, {})
        self.moves = self.state.setdefault("moves", {})
        self.issues, self.lines, self.done = {}, [], []
        self._rows = None
        agents = (sw.orca("agent", "list")[0] or {}).get("agents")
        terms = (sw.orca("terminal", "list")[0] or {}).get("terminals")
        if not isinstance(agents, list) or not isinstance(terms, list):
            raise RuntimeError("orca agent list か terminal list の形が変わった（agents・terminals が無い）")
        self.terms = {t.get("handle"): t for t in terms if t.get("connected")}
        self.panes = {a.get("paneKey"): a for a in agents if a.get("kind") == "terminal" and a.get("agent") == "claude"}
        self.chats = {a.get("orcaSessionId"): a for a in agents if a.get("kind") == "chat"}

    def save(self):
        if not self.dry_run:
            sw.save(STATE, self.state)

    def rows(self):
        if self._rows is None:
            self._rows = worker_rows()
        return self._rows

    def issue(self, key, label, kind, text):
        self.issues[key] = {"label": label, "kind": kind, "text": text}
        if self.dry_run:
            self.lines.append("  移さない: %s: %s" % (label, text))

    def seat_name(self, seat):
        return self.emails.get(seat) or seat or "既定の ~/.claude"

    # ----- 端末 -----
    def terminal(self, key, row, rec):
        t = self.terms.get(key) or {}
        label = rec["label"] if rec else "%s（端末 %s）" % (t.get("title") or key, os.path.basename(str(t.get("worktreePath") or "")))
        if rec is None:
            if not t:
                return self.issue(key, label, "gone", "Orca の端末の一覧に無い端末で claude が動いている（pid %d）。手で終える" % row["pid"])
            why = self.worker_without_settings(row)
            if why:
                return self.issue(key, label, "settings", why)
            if not row["session"]:
                return self.issue(key, label, "session", "会話 id が分からないので起こし直せない（sessions/%d.json も --resume も無い）。手で起こし直す" % row["pid"])
            lines = screen(key)
            if lines is None:
                return self.issue(key, label, "busy", "端末の画面を読めない。次の回に見る")
            why = sw.startup_screen(lines)
            if why:
                return self.issue(key, label, "screen", "確認の画面「%s」で止まっている（自動では答えない）。端末で答える" % why)
            lim = limited(row, t.get("preview"))
            # 入力待ちかは、Orca の状態と claude 自身の sessions/<pid>.json の status で見る。Orca の `terminal wait --for tui-idle` は
            # 入力待ちの古い席の端末でも時間切れになった（2026-11-23 の実機。上限の「continuing automatically at …」を待つものも、そうでないものも）
            state = (self.panes.get(pane(t)) or {}).get("state")
            working = state in BUSY_STATES or row["busy"]
            if working and not lim:
                return self.issue(key, label, "busy", "作業中。手が空いたら移す")
            if state is None and not lim:
                return self.issue(key, label, "busy", "Orca が claude の状態を出していないので、入力待ちか分からない。次の回に見る")
            rec = {"kind": "terminal", "pid": row["pid"], "session": row["session"], "argv": row["argv"], "ws": row["ws"],
                   "limited": lim, "working": bool(working), "label": label, "from": row["seat"], "stage": "exit", "at": self.now, "tries": 0}
            if self.dry_run:
                self.lines.append("  移す: %s: /exit → %s%s" % (label, relaunch_command(rec, self.home), "（続きを頼む）" if lim else ""))
                return
            self.moves[key] = rec
            self.save()
            # 送信が失敗に見えても届いていることがある（応答だけの時間切れ）ので、記録は残し、pid が消えるかで進める
            sw.orca("terminal", "send", "--terminal", key, "--text", "/exit", "--enter", "--wait-submit", "10")
        if self.dry_run:
            return self.lines.append("  移しかけ: %s（%s の段階から続ける）" % (label, rec["stage"]))
        if rec["stage"] == "exit":
            if not self.wait(lambda: not alive(rec["pid"], key), EXIT_WAIT_S):
                return self.retry(key, rec, "/exit のあと claude が終わらない（/exit は打ち直さない）")
            others = [r for r in inventory() if r["handle"] == key]
            if others:
                # 人が同じ端末で claude を起こし直した。今の席なら済み、古い席なら次の回に新しいプロセスとして見る
                self.moves.pop(key)
                self.save()
                return self.done.append(label) if others[0]["seat"] == self.target else None
            rec.update(stage="launch", tries=0)
            self.save()
        if rec["stage"] == "launch" and [r for r in inventory() if r["handle"] == key]:
            rec.update(stage="launched", launched_at=self.now)  # 前の回がコマンドを送ってから記録する前に落ちた。起きた claude に打ち直さない
            self.save()
        if rec["stage"] == "launch":
            if key not in self.terms:
                self.moves.pop(key)
                self.save()
                return self.issue(key, label, "gone", "claude を終えたあと端末が閉じた。会話 %s は `claude --resume` で開ける" % rec["session"])
            if sw.orca("terminal", "send", "--terminal", key, "--text", relaunch_command(rec, self.home), "--enter")[0] is None:
                return self.retry(key, rec, "起こし直すコマンドを送れなかった（端末はシェルのまま）")
            rec.update(stage="launched", launched_at=self.now)
            self.save()
        # 起きた claude が入力待ち（sessions/<pid>.json の status が idle）になるか、確認の画面で止まるのを待つ
        seen = {}
        def check():
            lines = screen(key)
            seen.update(new=[r for r in inventory() if r["handle"] == key], read=lines is not None, screen=sw.startup_screen(lines or []))
            return seen["screen"] or (seen["read"] and seen["new"] and seen["new"][0]["status"] == "idle")
        self.wait(check, APPEAR_WAIT_S)
        new = seen["new"]
        if seen["screen"]:
            return self.issue(key, label, "screen", "今の席で起こし直したが、確認の画面「%s」で止まっている（自動では答えない）。"
                                                    "端末で答える（答えたら続きを頼む）" % seen["screen"])
        if not new:
            if self.now - rec.get("launched_at", self.now) < 3 * MIN:
                return self.issue(key, label, "moving", "起こし直した claude がまだ起きていない")
            rec["stage"] = "launch"
            return self.retry(key, rec, "起こし直すコマンドを送ったが claude が起きない。打ち直す: %s" % relaunch_command(rec, self.home))
        if len(new) > 1 or new[0]["seat"] != self.target or new[0]["session"] != rec["session"]:
            rec.update(stage="failed", failed_at="launched", why="この端末で起きた claude が、今の席で会話 %s を開き直したものと確かめられない（pid %s）。"
                       "続きは頼んでいない。端末を確かめて手で移す" % (rec["session"], ", ".join(str(r["pid"]) for r in new)))
            self.save()
            return self.issue(key, label, "failed", rec["why"])
        if new[0]["status"] != "idle" or not seen["read"]:
            return self.retry(key, rec, "今の席で起こし直したが、入力待ちにならない" if seen["read"] else "今の席で起こし直したが、端末の画面を読めない")
        if rec["limited"] or rec["working"]:
            if sw.orca("terminal", "send", "--terminal", key, "--text", NUDGE % self.email, "--enter", "--wait-submit", "10")[0] is None:
                return self.retry(key, rec, "今の席で起こし直したが、続きを頼めなかった")
        self.moves.pop(key)
        self.save()
        log({"event": "moved", "kind": "terminal", "handle": key, "label": label, "session": rec["session"], "from": self.seat_name(rec["from"]),
             "to": self.email, "nudged": bool(rec["limited"] or rec["working"])})
        self.done.append(label)

    def worker_without_settings(self, row):
        """worker（worker の設定 --settings で起きたか、Dispatch を受けたことがある端末）なのに設定を読めなければ、その理由。
        sandbox の外で動かさないよう、そのときは触らない。ORCA_WORKER_SETTINGS は Orca の中の claude がみな受け継いでいる
        （2026-11-23 に確かめた）ので、worker の印にはしない。"""
        f = settings_file(row["argv"])
        if f:
            return None if os.path.isfile(os.path.expanduser(f)) else "worker の設定 %s を読めないので触らない。手で移す" % f
        try:
            ever = {w.get("terminal") for w in self.rows()}
        except RuntimeError as e:
            return "worker か確かめられない（%s）ので触らない" % e
        if row["handle"] in ever:
            return "Dispatch を受けた端末（worker）だが、claude の引数に worker の設定（--settings のファイル）が無いので触らない。" \
                   "worker の設定で起こし直してから移す"
        return None

    # ----- チャット -----
    def chat(self, key, row, rec):
        a = self.chats.get((row or {}).get("chat")) or {}
        title = rec["title"] if rec else a.get("title") or row["chat"] or row["handle"]
        label = "%s（チャット）" % title
        if rec is None:
            if not a:
                return self.issue(key, label, "unknown", "Orca のチャットの一覧に無いので触らない。手で終える（pid %d）" % row["pid"])
            lim = limited(row)
            if (a.get("state") in BUSY_STATES or row["busy"]) and not lim:
                return self.issue(key, label, "busy", "作業中のターンがある。終わったら止める")
            disp = run = None
            if str(row["handle"] or "").startswith("structworker_"):
                try:
                    disp = next((w["dispatchId"] for w in self.rows() if w.get("terminal") == row["handle"] and w.get("outcome") == "in_progress"), None)
                except RuntimeError as e:
                    return self.issue(key, label, "failed", "担当の Dispatch を確かめられない（%s）ので止めていない" % e)
                if disp:
                    # --full を付けない worker-show は runId を result の直下に返す（--full だと dispatch.runId）
                    run = (sw.orca("orchestration", "worker-show", "--dispatch", disp)[0] or {}).get("runId")
                    if not run:
                        return self.issue(key, label, "failed", "Dispatch %s の Run を読めず、先の知らせを送れないので止めていない" % disp)
            rec = {"kind": "chat", "pid": row["pid"], "handle": row["handle"], "limited": lim, "dispatch": disp, "run": run, "label": label, "title": title,
                   "from": row["seat"], "stage": "notice" if disp else "stop", "at": self.now, "tries": 0}
            if self.dry_run:
                return self.lines.append("  止める: %s%s%s" % (label, "（先に run:%s へ知らせる）" % run if disp else "",
                                                             "（上限で止まっていたので、止めたあと続きを送る）" if lim and disp else ""))
            self.moves[key] = rec
            self.save()
        if self.dry_run:
            return self.lines.append("  止めかけ: %s（%s の段階から続ける）" % (label, rec["stage"]))
        if rec["stage"] in ("notice", "stop") and self.keep_or_drop(key, rec, label):
            return
        if rec["stage"] == "notice":
            if not send_tell({"from": rec["handle"], "to": "run:" + rec["run"], "subject": "席の切り替えで担当の claude を止めた",
                              "body": CHAT_NOTICE % title}):
                return self.retry(key, rec, "止める前の知らせを run:%s に送れなかったので、まだ止めていない" % rec["run"])
            rec.update(stage="stop", tries=0)
            self.save()
            if self.keep_or_drop(key, rec, label):
                return
        if rec["stage"] == "stop":
            if alive(rec["pid"], key):
                stop(rec["pid"])
            if not self.wait(lambda: not alive(rec["pid"], key), STOP_WAIT_S):
                return self.retry(key, rec, "裏の claude（pid %d）に SIGTERM を送ったが終わらない" % rec["pid"])
            rec.update(stage="stopped", tries=0)
            self.save()
        resumed = bool(rec["limited"] and rec["dispatch"])
        if resumed:
            # Dispatch あてのメッセージで、Orca が同じ会話のまま今の席の claude を起こす。窓口（Dispatch 無し）は Orca の自動の続きに任せる
            tell(rec["handle"], "席の切り替えで起こし直した", CHAT_RESUME, to="dispatch:" + rec["dispatch"])
        self.moves.pop(key)
        self.save()
        log({"event": "moved", "kind": "chat", "key": key, "label": label, "dispatch": rec["dispatch"], "from": self.seat_name(rec["from"]),
             "to": self.email, "resumed": resumed})
        self.done.append(label)

    def keep_or_drop(self, key, rec, label):
        """チャットを止める（知らせる）直前に、今の状態を読み直す。今の席に移っていたか、新しいターンが始まっていれば記録を消して止めない。
        止めないなら True。端末を移すあいだや前の回から待つあいだに、状態が変わることがある。"""
        now = next((r for r in inventory() if r["pid"] == rec["pid"] and key_of(r) == key), None)
        if now is None:
            return False  # もう終わっている。止める段階で済になる
        a = next((x for x in (sw.orca("agent", "list")[0] or {}).get("agents") or []
                  if x.get("kind") == "chat" and x.get("orcaSessionId") == now["chat"]), {})
        if now["seat"] == self.target:
            self.moves.pop(key)
            self.save()
            self.done.append(label)
            return True
        if (a.get("state") in BUSY_STATES or now["busy"]) and not limited(now):
            self.moves.pop(key)
            self.save()
            self.issue(key, label, "busy", "作業中のターンがある。終わったら止める")
            return True
        return False

    def retry(self, key, rec, why):
        rec["tries"] = rec.get("tries", 0) + 1
        if rec["tries"] >= MAX_TRIES:
            # 7: 諦めた印を残し、手で直ったと分かるまで帯に出し続ける（消すと、同じことを最初から試すか、何も出さなくなる）
            rec.update(stage="failed", failed_at=rec["stage"], why="%s。%d 回試して諦めた。手で移す" % (why, MAX_TRIES))
            self.save()
            log({"event": "gave-up", "key": key, "label": rec["label"], "stage": rec["failed_at"], "why": why})
            return self.issue(key, rec["label"], "failed", rec["why"])
        self.save()
        return self.issue(key, rec["label"], "moving", why + "。次の回に続きから試す")

    def failed(self, key, rec, rows):
        """諦めたものは、手で直ったと分かるまで帯に出す。端末は今の席の claude が起きたか端末が閉じたら、チャットは古い claude が消えたら済。"""
        mine = [r for r in rows if key_of(r) == key]
        if rec["kind"] == "terminal":
            fixed = key not in self.terms or (mine and all(r["seat"] == self.target for r in mine))
        else:
            fixed = not any(r["pid"] == rec["pid"] for r in mine)
        if fixed:
            self.moves.pop(key)
            self.save()
            return self.done.append(rec["label"])
        self.issue(key, rec["label"], "failed", rec["why"])

    @staticmethod
    def wait(cond, seconds):
        deadline = time.time() + seconds
        while True:
            if cond():
                return True
            if time.time() >= deadline:
                return False
            time.sleep(min(1, max(0, deadline - time.time())))

    def run(self, rows):
        stale = {key_of(r): r for r in rows if r["seat"] != self.target}
        handles = {}
        for r in rows:
            if r["kind"] == "terminal":
                handles[r["handle"]] = handles.get(r["handle"], 0) + 1
        seen = self.state.setdefault("converge", {})
        for key in sorted(set(stale) | set(self.moves)):
            row, rec = stale.get(key), self.moves.get(key)
            if rec is None and row is None:
                continue
            first = (seen.get(key) or {}).get("since", self.now)
            old = seen.get(key) or {}
            if rec is None and self.now - first > GIVE_UP_MS:
                self.issue(key, old.get("label") or key, "gaveup", old["text"] if old.get("kind") == "gaveup" else
                           "%d 時間たっても移せないので諦めた（%s）。手で移す" % (GIVE_UP_MS // (60 * MIN), old.get("text") or "手が空かない"))
                continue
            if rec and rec["stage"] == "failed":
                self.failed(key, rec, rows)
                continue
            if rec is None and row["kind"] == "terminal" and handles.get(key, 0) > 1:
                self.issue(key, old.get("label") or key, "failed", "同じ端末に claude が %d 個ある（pid %s）ので触らない。端末を確かめて手で移す" % (
                    handles[key], ", ".join(str(r["pid"]) for r in rows if r["handle"] == key)))
                continue
            (self.chat if (rec or row)["kind"] == "chat" else self.terminal)(key, row, rec)


def converge(home, email, emails, now, dry_run):
    """古い席の claude を今の席（home）へ移し、最後に数え直す。窓の帯に出す知らせの一覧を返す（dry_run では計画を出すだけ）。
    今の席と違うプロセスも移しかけの記録も無ければ、プロセスの一覧を 1 回読んで終える。"""
    rows = inventory()
    target = seat_key(home)
    state = sw.load(STATE, {})
    if all(r["seat"] == target for r in rows) and not state.get("moves"):
        if dry_run:
            print("Orca の中の claude %d 個はみな今の席 %s で動いている" % (len(rows), email))
        elif state.get("converge"):
            state.pop("converge")
            state.pop("converge_told", None)
            sw.save(STATE, state)
            log({"event": "converged", "seat": email, "count": len(rows)})
        return []
    m = Mover(home, email, emails, now, dry_run)
    if dry_run:
        print("今の席 %s と違う席で動いている claude:" % email)
    m.run(rows)
    if dry_run:
        print("\n".join(m.lines) or "  なし")
        return []
    # 数え直す。古い席に残るものは、名前・理由・次に要る操作を帯に出す
    left = {key_of(r): r for r in inventory() if r["seat"] != target}
    seen, out = m.state.setdefault("converge", {}), []
    for key in sorted(set(left) | set(m.moves)):
        info = m.issues.get(key) or {"label": key, "kind": "moving", "text": "移している途中"}
        seen[key] = dict(info, since=(seen.get(key) or {}).get("since", now))
        r = left.get(key)
        out.append({"id": CONVERGE_ID + key, "text": "%s が古い席 %s の claude のまま: %s" % (
            info["label"], m.seat_name(r["seat"]) if r else "（移しかけ）", info["text"])})
    for key in [k for k in seen if k not in left and k not in m.moves]:
        seen.pop(key)
    # 通知は、人の手が要るもの（作業中・移している途中を除く）が新しく出たときだけ
    told = set(m.state.get("converge_told") or [])
    need = {"%s|%s" % (k, v["kind"]) for k, v in seen.items() if v["kind"] not in ("busy", "moving")}
    fresh = sorted(need - told)
    if fresh:
        sw.notify(["%s: %s" % (seen[k.split("|")[0]]["label"], seen[k.split("|")[0]]["text"]) for k in fresh], title="Claude の席を移せないもの")
    m.state["converge_told"] = sorted(need)
    if m.done:
        log({"event": "converge", "moved": m.done, "left": {k: v["text"] for k, v in seen.items()}})
    if not seen:
        m.state.pop("converge", None)
        m.state.pop("converge_told", None)
        if m.done:
            log({"event": "converged", "seat": email})
    sw.save(STATE, m.state)
    return out


def print_inventory():
    """Orca の中の claude を 1 プロセス 1 行（席・種類・handle・題・状態）で出す。今の席と違うものがあれば 1 を返す。"""
    claude = orca_ok("account", "list").get("claude") or {}
    accounts = claude.get("accounts") or []
    active = next((a for a in accounts if a.get("id") == claude.get("activeAccountId")), {})
    emails = {seat_key(a.get("home")): a.get("email") for a in accounts}
    agents = (sw.orca("agent", "list")[0] or {}).get("agents") or []
    terms = {t.get("handle"): t for t in (sw.orca("terminal", "list")[0] or {}).get("terminals") or []}
    panes = {a.get("paneKey"): a for a in agents if a.get("kind") == "terminal"}
    chats = {a.get("orcaSessionId"): a for a in agents if a.get("kind") == "chat"}
    target = seat_key(active.get("home"))
    rows = inventory()
    print("今の席: %s" % (active.get("email") or "不明"))
    old = 0
    for r in rows:
        if r["kind"] == "chat":
            a, kind = chats.get(r["chat"]) or {}, "チャット"
            title = a.get("title") or r["chat"] or r["handle"]
        else:
            t, kind = terms.get(r["handle"]), "端末"
            a, title = (panes.get(pane(t)) or {}, t.get("title") or r["handle"]) if t else ({}, "（Orca の端末の一覧に無い）")
        bad = r["seat"] != target
        old += bad
        print("\t".join([emails.get(r["seat"]) or r["seat"] or "既定の ~/.claude", kind, r["handle"] or "-", title,
                         (a.get("state") or ("busy" if r["busy"] else "-")) + ("　← 古い席" if bad else "")]))
    print("合わせて %d 個。今の席と違うもの %d 個" % (len(rows), old))
    return 1 if old else 0


def write_status(alerts):
    sw.save(STATUS, {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "alerts": alerts})


def log(record):
    record = dict(at=time.strftime("%Y-%m-%dT%H:%M:%S%z"), **record)
    line = json.dumps(record, ensure_ascii=False)
    print(line)
    os.makedirs(HOME, exist_ok=True)
    with open(HISTORY, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")


def switch(a, state, accounts, now):
    """今の席が上限なら切り替える。(帯に出す知らせ, 今の席の id（dry_run では切り替えたなら移る先）)。"""
    claude, limits = accounts.get("claude"), accounts.get("rateLimits")
    by_email = {(x.get("email") or "").lower(): x["id"] for x in claude.get("accounts") or []}
    missing = [e for e in a.seat if e.lower() not in by_email]
    if missing:
        raise RuntimeError("Orca に無い席: %s" % ", ".join(missing))
    order = [by_email[e.lower()] for e in a.seat]
    active = claude.get("activeAccountId")
    seats = seat_states(claude, limits, now)
    email = lambda sid: (seats.get(sid) or {}).get("email") or str(sid)
    summary = ", ".join("%s=%s%s" % (seats[s]["email"], SHOWN[seats[s]["state"]],
                                     "（%s に戻る）" % clock(seats[s]["back"], now) if seats[s]["back"] else "") for s in order)
    previous = [x for x in sw.load(STATUS, {}).get("alerts", []) if not str(x.get("id")).startswith(CONVERGE_ID)]
    if a.assume_full and active in seats:
        seats[active] = dict(seats[active], state="full", back=seats[active]["back"] or now + UNKNOWN_BACK_MS)
    blocked = unusable(order, active, seats)
    blocked_text = "、".join("%s は%s" % (email(sid), why) for sid, why in blocked.items())
    if a.dry_run and blocked:
        print("行き先にできない席: " + blocked_text)
    if (seats.get(active) or {}).get("state") != "full":
        blind = None
        # 往復の数え（switches）は 6 時間で消えるので、最後に移った先は別に持つ。
        moved = state.get("moved_to") or {}
        if (seats.get(active) or {}).get("state") == "unknown" and moved.get("id") == active and now - moved["at"] >= BLIND_MS:
            blind = {"id": "failover:blind:%s" % active,
                     "text": "今の Claude の席 %s の使用量を Orca が読めていない。上限に当たっても自動では切り替えられない" % email(active)}
        if a.dry_run:
            print("今の席 %s は上限ではない%s。切り替えない。[%s]" % (
                email(active), "（使用量が読めない）" if seats.get(active, {}).get("state") == "unknown" else "", summary))
            return [], active
        state.pop("all_full", None)
        sw.save(STATE, state)
        keep = [x for x in previous if x.get("until") and now < x["until"]]
        ahead = [{"id": "failover:seat:%s" % sid, "text": "上限に当たっても Claude の席 %s へは切り替えない: %s" % (email(sid), why)}
                 for sid, why in blocked.items()]
        return keep + ([blind] if blind else []) + ahead, active
    if active not in order:
        print("今の席 %s は --seat に無いので切り替えない。[%s]" % (email(active), summary))
        return previous, active
    last = max((s["at"] for s in state["switches"]), default=0)
    if now - last < GAP_MS and not a.dry_run:
        print("前の切り替えから %d 分なので待つ。[%s]" % ((now - last) // MIN, summary))
        return previous, active
    target = choose(order, active, seats, state["left"], now, blocked)
    if target is None:
        back = earliest_back(order, active, seats, state["left"], now)
        when = "（最初に戻るのは %s の %s）" % (back[1], clock(back[0], now)) if back else "（戻る時刻は不明）"
        # 外した席を除かなければ行き先があった（上限ではないが使えない席がある）。
        spare = choose(order, active, seats, state["left"], now) is not None
        text = ("Claude の席 %s が利用枠の上限で、切り替えられる席が無い。%s。切り替えずに待つ%s" % (email(active), blocked_text, when)
                if spare else "Claude の全部の席が利用枠の上限。切り替えずに待つ" + when)
        if a.dry_run:
            print(text + " [%s]" % summary)
            return [], active
        aid = "failover:%s:%s" % ("no-seat" if spare else "all-full", back[0] if back else "")
        if state.get("all_full") != aid:
            sw.notify([text], title="Claude の席")
            log({"event": "all-full", "seats": summary, "text": text})
            state["all_full"] = aid
        sw.save(STATE, state)
        return [{"id": aid, "text": text}], active
    if len(state["switches"]) >= FLAP_MAX and not a.dry_run:
        text = "Claude の席の切り替えが %d 時間で %d 回を超えたので、自動の切り替えを止めた（往復していないか確かめる）" % (
            FLAP_WINDOW_MS // (60 * MIN), FLAP_MAX)
        aid = "failover:flapping"
        if state.get("all_full") != aid:
            sw.notify([text], title="Claude の席")
            log({"event": "flapping", "seats": summary})
            state["all_full"] = aid
        sw.save(STATE, state)
        return [{"id": aid, "text": text}], active
    if a.dry_run:
        print("切り替える: %s → %s [%s]" % (email(active), email(target), summary))
        return [], target
    orca_ok("account", "select", "--agent", "claude", "--account", target)
    after = sw.orca("account", "list")[0]
    if after is not None and (after.get("claude") or {}).get("activeAccountId") != target:
        raise RuntimeError("orca account select のあとも席が %s のまま" % email(active))
    state["left"][active] = {"at": now, "back": seats[active]["back"] or now + UNKNOWN_BACK_MS}
    state["switches"].append({"at": now, "from": active, "to": target})
    state["moved_to"] = {"id": target, "at": now}
    state.pop("all_full", None)
    sw.save(STATE, state)
    text = "Claude の席を %s から %s に切り替えた。古い席で動いている claude を、手が空いたものから今の席へ移す（移せないものは帯に出す）" % (
        email(active), email(target))
    sw.notify([text], title="Claude の席を切り替えた")
    log({"event": "switched", "from": email(active), "to": email(target), "seats": summary})
    return [{"id": "failover:switched:%d" % now, "text": text, "until": now + BAND_MS}], target


def run(a):
    now = sw.now_ms()
    state = sw.load(STATE, {})
    state.setdefault("left", {})
    state["switches"] = [s for s in state.get("switches", []) if now - s["at"] < FLAP_WINDOW_MS]
    # 使用量（rateLimits）は --agent を付けない一覧にだけ付く。
    accounts = orca_ok("account", "list")
    claude, limits = accounts.get("claude"), accounts.get("rateLimits")
    if not isinstance(claude, dict) or not isinstance(claude.get("accounts"), list) or not isinstance(limits, dict):
        raise RuntimeError("orca account list の形が変わった（claude.accounts と rateLimits が無い）")
    alerts, active = switch(a, state, accounts, now)
    if not a.dry_run and os.path.exists(TELLS):
        flush_tells(now)
    acc = next((x for x in claude["accounts"] if x.get("id") == active), {})
    emails = {seat_key(x.get("home")): x.get("email") for x in claude["accounts"]}
    # 切り替えの判断の早い戻りに関わらず、毎回、古い席のプロセスを移す（手で切り替えたときも、自動の切り替えの直後も）。
    try:
        alerts = alerts + converge(acc.get("home"), acc.get("email") or str(active), emails, now, a.dry_run)
    except Exception as e:  # 切り替えの知らせは帯に残し、移す処理の失敗も帯に出してから落とす（main が 1 回だけ通知する）
        if not a.dry_run:
            write_status(alerts + [{"id": CONVERGE_ID + "error", "text": "古い席の claude を今の席へ移す処理が失敗した: %s" % e}])
        raise
    if not a.dry_run:
        write_status(alerts)


def main():
    ap = argparse.ArgumentParser(prog="account-failover", description=__doc__.split("\n")[0])
    ap.add_argument("--seat", action="append", metavar="EMAIL", help="切り替え先にしてよい席。優先度の高い順に並べる")
    ap.add_argument("--dry-run", action="store_true", help="どの席へ切り替え、どの claude をどう移すかを出すだけにする")
    ap.add_argument("--assume-full", action="store_true", help="試験用。今の席を上限と見なす（--dry-run と合わせて使う）")
    ap.add_argument("--inventory", action="store_true",
                    help="Orca の中の claude を 1 プロセス 1 行で出し、今の席と違うものがあれば終了コード 1 にする（何も変えない）")
    a = ap.parse_args()
    if a.inventory:
        sys.exit(print_inventory())
    if not a.seat:
        ap.error("--seat が要る")
    if a.assume_full and not a.dry_run:
        ap.error("--assume-full は --dry-run と合わせて使う")
    if a.dry_run:
        return run(a)
    os.makedirs(HOME, exist_ok=True)
    with open(os.path.join(HOME, "failover.lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
        failed = os.path.join(HOME, "failover-failed")
        try:
            run(a)
        except Exception as e:  # launchd は失敗を誰にも見せないので、同じ失敗は 1 回だけ通知にする
            text = "席の切り替え（account-failover）が失敗した: %s" % e
            if sw.load(failed, None) != text:
                sw.notify([text], title="Claude の席")
                sw.save(failed, text)
            raise
        if os.path.exists(failed):
            os.remove(failed)


if __name__ == "__main__":
    main()
