#!/usr/bin/env python3
"""Orca の監督の外で止まったもの（各ワークスペースのメイン・操縦席の窓のサーバー・launchd の定時ジョブ）を見つけて知らせる。

launchd が数分おきに 1 回ずつ起こす。Orca や Claude の会話の中に置くと、Orca の更新や会話の終わりと一緒に止まるため外に置く。モデルは呼ばない。
worker の生死は Orca の orchestration（worker-start の監督）が見て、worker_done・escalation でその coordinator を起こすので、ここでは見ない。
知らせは通知と窓の上の帯に出すだけで、窓口には送らない。worker が止まったあとメインが動いていないものは、帳簿の済んでいないタスクの
窓口が立てた worker に限って人に知らせる（窓口を起こすのは Orca の escalation で、ここからも送ると同じ知らせが二重に届き、返事は誰も読まない。t178）。
"""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

HOME = os.environ.get("STALLWATCH_HOME") or os.path.expanduser("~/Library/Application Support/stallwatch")
COCKPIT_DIR = os.environ.get("COCKPIT_DIR") or os.path.expanduser("~/Library/Application Support/cockpit")
UNHANDLED_MS = 10 * 60_000
# 作業中のまま Orca の記録が更新されない時間。長いテストやビルドでも Orca は状態を更新するので、それより十分長くとる。
STALE_MS = 45 * 60_000
LOG_TAIL = 20_000
LOG_ERRORS = 3
# ログのエラーは窓を開き直したときだけ出ることがあるので、最後のエラーからこれだけの間は直ったと見なさない。
LOG_STICKY_MS = 60 * 60_000
LOG_ERROR = re.compile(r"\b(Error|ENOENT|EACCES|EADDRINUSE|Unhandled|Traceback)\b")
JOB_FAILED = re.compile(r"(?i)\b(error|failed|failure|fatal|traceback|unauthorized)\b|失敗|エラー")
# 会話記録の API のエラーの応答（isApiErrorMessage）の本文に当てる。orca-state.ts の stopReason が Orca の失敗の detail に当てるものと同じ。
# Claude Code の上限の 1 行は「You've hit your 5-hour limit · resets 4:40pm (Asia/Tokyo)」「You've reached your Fable limit.」の形。
LIMIT = re.compile(r"(?i)usage limit|rate limit|limit reached|out of extra usage|上限に達|hit your [\w -]*limit|reached your [\w -]*limit")
AUTH = re.compile(r"(?i)/login|not logged in|authentication_error|oauth token|invalid api key|\b401\b")
RESETS = re.compile(r"resets (?:([A-Z][a-z]{2}) (\d{1,2}) at )?(\d{1,2})(?::(\d{2}))?([ap]m)(?: \(([^)]+)\))?")
MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()
# Orca は起動し直すと全員の stateStartedAt を数秒のうちに付け直す（2026-11-21 の再起動では 7 人が 3 秒以内）。
RESTART_SKEW_MS = 5_000
# Orca が outcome: failure を付けた時刻（stateStartedAt）と、窓口の会話記録の最後の応答の時刻の差。実測は 10ms 未満。
REPLY_SKEW_MS = 2 * 60_000
TRANSCRIPT_TAIL = 256 * 1024
LABEL = {"working": "作業中", "done": "止まった", "blocked": "許可待ち", "waiting": "返事待ち"}


def now_ms():
    return int(time.time() * 1000)


def load(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def alert(aid, text, root=None, confirm=False):
    """confirm: 2 回続けて見えたら出す（Orca の更新や再起動の途中の一瞬を知らせない）。"""
    return {"id": aid, "text": text, "root": root, "confirm": confirm}


def orca(*args, timeout=30):
    """(result, エラーの 1 行, runtimeId)。runtimeId は Orca が起動するたびに変わる。"""
    try:
        r = subprocess.run([os.environ.get("ORCA_CLI_COMMAND") or "orca"] + list(args) + ["--json"],
                           capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, str(e), None
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return None, " ".join((r.stderr or r.stdout or "出力なし").split())[:160], None
    if not d.get("ok"):
        return None, ((d.get("error") or {}).get("message") or "ok でない")[:160], None
    return d.get("result") or {}, None, (d.get("_meta") or {}).get("runtimeId")


# Claude Code が起動のときに出して入力を止める画面。上から順に当てる。
STARTUP_SCREENS = (
    ("ログインの画面（この席はログインし直しが要る）",
     re.compile(r"(?i)select login method|please run /login|not logged in|invalid api key|oauth token (?:has )?(?:expired|revoked)")),
    ("フォルダを信頼するかの確認（この席で初めて開く作業場所）", re.compile(r"(?i)do you trust|trust this folder|trust the files in this")),
    ("auto mode を既定にするかの確認", re.compile(r"(?i)set auto mode as my default")),
    ("bypass permissions の同意の確認", re.compile(r"(?i)yes, i accept")),
    ("初回の設定の画面", re.compile(r"(?i)choose the text style|let's get started")),
    # 席ごとに承認が要り、席を移した端末が止まる（2026-11-22 の切り替えで ca-test-plan の端末が止まった）。承認は席ごとに人が一度する（R205）
    ("CLAUDE.md の外部 import の承認（External imports）", re.compile(r"(?i)external (?:claude\.md )?(?:file )?imports|imports files outside")),
)
# 画面の下のこの行数だけを見る。上には開き直した会話の文が残り、確認の画面の文言を含むことがある。
SCREEN_LINES = 25


def screen_tail(handle):
    """端末の今の画面の、空でない最後の行（最大 SCREEN_LINES 行）。読めなければ []。"""
    t = (orca("terminal", "read", "--terminal", handle, "--screen")[0] or {}).get("terminal") or {}
    return [l.rstrip() for l in t.get("tail") or [] if l.strip()][-SCREEN_LINES:]


def startup_screen(lines):
    """画面の行から、起動時の確認の画面の名前。当たらなければ None。"""
    text = " ".join(" ".join(lines).split())
    return next((name for name, pat in STARTUP_SCREENS if pat.search(text)), None)


def seat_screens(home):
    """席の置き場所（Orca の席の home）の設定から、その席で claude を対話で起こすと出て入力を止める確認の画面の名前の一覧。
    フォルダの信頼は作業場所ごとなのでここでは見ない。.claude.json と settings.json の読み方は Claude Code 2.1 の条件に合わせている。"""
    if not home:
        return []
    path = os.path.join(home, ".claude.json")
    if not os.path.exists(path):
        return ["初回の設定の画面"]  # その席でまだ一度も claude を起こしていない
    cfg, settings = load(path, None), load(os.path.join(home, "settings.json"), {})
    if not isinstance(cfg, dict):
        return []  # 書きかけなどで読めないだけのときは、外さない
    out = []
    if not cfg.get("hasCompletedOnboarding"):
        out.append("初回の設定の画面")
    mode = ((settings if isinstance(settings, dict) else {}).get("permissions") or {}).get("defaultMode")
    if mode and mode != "auto" and not cfg.get("hasSeenAutoDefaultNudge"):
        out.append("auto mode を既定にするかの確認")
    return out


def pick_main(agents):
    """本線にいるエージェントのうちメインに当たるもの。1 人ならその人、複数ならチャット、それも複数なら最近動いた方。
    窓（orca-state.ts）は cockpit.json の main.terminal で引くが、チャットのメインは端末を持たないので、ここでは形で選ぶ。"""
    if len(agents) <= 1:
        return agents[0] if agents else None
    chats = [a for a in agents if str(a.get("paneKey", "")).startswith("structured-agent-session-")] or agents
    return max(chats, key=lambda a: a.get("updatedAt") or a.get("stateStartedAt") or 0)


def reset_at(text, at):
    """上限の 1 行の「resets 4:40pm (Asia/Tokyo)」「resets Nov 22 at 9am (Asia/Tokyo)」が指す時刻（ms）。at は上限に当たった時刻。"""
    m = RESETS.search(text)
    if not m:
        return None
    mon, day, hour, minute, ampm, tz = m.groups()
    try:
        zone = ZoneInfo(tz) if tz else None
    except (ZoneInfoNotFoundError, ValueError):
        zone = None
    base = datetime.fromtimestamp(at / 1000, zone) if zone else datetime.fromtimestamp(at / 1000).astimezone()
    try:
        t = base.replace(hour=int(hour) % 12 + (12 if ampm == "pm" else 0), minute=int(minute or 0), second=0, microsecond=0)
        if mon:
            t = t.replace(month=MONTHS.index(mon) + 1, day=int(day))
            if t < base:
                t = t.replace(year=t.year + 1)
        elif t <= base:
            t += timedelta(days=1)
    except ValueError:
        return None
    return int(t.timestamp() * 1000)


def clock(ms, now):
    t = time.localtime(ms / 1000)
    same_day = time.strftime("%Y%m%d", t) == time.strftime("%Y%m%d", time.localtime(now / 1000))
    return time.strftime("%H:%M" if same_day else "%-m/%-d %H:%M", t)


def api_stop(reply, now):
    """会話記録の最後の応答（last_assistant の結果）から、利用枠の上限とログイン切れを見分ける。
    Claude Code が API のエラーとして書いた応答だけを見る。普通の応答は、上限の 1 行を引用した報告でも止まった理由にしない（2026-11-28 13:44 の誤報）。"""
    if not isinstance(reply, tuple) or not reply[2]:
        return None
    at, text, _ = reply
    if LIMIT.search(text):
        reset = reset_at(text, at)
        if reset is None:
            return "利用枠の上限で止まった"
        if now < reset:
            return "利用枠の上限で止まった（%s に戻る）" % clock(reset, now)
        # 枠が戻っても、上限で途切れた作業は誰かが入力するまで再開しないので、消さずに弱めて残す。
        return "利用枠の上限で止まったまま（枠は %s に戻った。新しい入力を待っている）" % clock(reset, now)
    if AUTH.search(text):
        return "ログインが切れて止まった"
    return None


def ms_of(iso):
    try:
        return int(datetime.fromisoformat(str(iso).replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return None


def last_assistant(path):
    """会話記録の末尾の、最後の assistant の (時刻, 本文, API のエラーか)。そのあとに入力（user）があれば "input"、読めなければ None。"""
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, os.path.getsize(path) - TRANSCRIPT_TAIL))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if isinstance(e, dict) and e.get("type") == "user":
            return "input"  # 最後の応答より新しい入力がある（ターンの途中か、答えを待っている）
        if isinstance(e, dict) and e.get("type") == "assistant":
            content = (e.get("message") or {}).get("content")
            text = content if isinstance(content, str) else "".join(
                c.get("text") or "" for c in content or [] if isinstance(c, dict) and c.get("type") == "text")
            return ms_of(e.get("timestamp")) or 0, text, bool(e.get("isApiErrorMessage"))
    return None


def main_reply(root, at):
    """窓口の会話記録の最後の応答。窓口の会話は hook が帳簿の横の main-session.json に書いたもので選ぶ（同じ root の質問のタブや
    別のチャットと取り違えない）。その応答の時刻が Orca の失敗の時刻 at と合わなければ、別のターンなので None。"""
    path = load(os.path.join(root, ".orca", "cockpit", "main-session.json"), {}).get("transcript_path")
    reply = last_assistant(path) if path else None
    return reply if isinstance(reply, tuple) and abs(reply[0] - at) <= REPLY_SKEW_MS else None


def main_stop(a, root, now):
    if a.get("hasLivePty") is False:
        return "端末が終わった"
    if a.get("state") != "done" or (a.get("mainAgent") or {}).get("outcome") != "failure":
        return None
    # 理由は窓口の会話記録の最後の応答から読む。Orca の lastAssistantMessage は 200 字で切った要約で、API のエラーの 1 行が入らず
    # 前の報告が残る（2026-11-21）一方、報告の中の上限の引用は入る（2026-11-28）。
    reply = main_reply(root, a.get("stateStartedAt") or now)
    cause = api_stop(reply, now)
    if cause:
        return cause
    if reply and reply[2]:
        return "API のエラーで止まった（%s）" % " ".join(reply[1].split())[:100]
    return "エラーで止まった"


def note_restart(state, runtime, now):
    """Orca が起動し直した時刻の幅と、その前に作業中だったメイン。再起動の判定はここと by_restart だけで持つ。
    runtimeId が変わったら、前に Orca を読めた回から今回までのどこかで起動し直している。
    見張りが見る前の再起動は時刻が分からないので、初めての回までの全部を幅にする。"""
    restart = state.get("restart") or {"from": 0, "to": now, "working": []}
    if runtime and state.get("runtime") and runtime != state["runtime"]:
        restart = {"from": state.get("read_at", 0), "to": now,
                   "working": sorted(k for k, v in state.get("main_state", {}).items() if v == "working")}
    if runtime:
        state["runtime"] = runtime
    state["restart"], state["read_at"] = restart, now
    return restart


def by_restart(restart, *stamps):
    """stamps（stateStartedAt）がどれも、その再起動で Orca が一斉に付け直したものか。"""
    return (all(restart["from"] <= t <= restart["to"] for t in stamps)
            and max(stamps) - min(stamps) <= RESTART_SKEW_MS)


def check_mains(now, state):
    res, err, runtime = orca("worktree", "ps", "--limit", "1000")
    if res is None:
        return [alert("orca-down", "Orca に繋がらない（%s）。各ワークスペースのメインと worker は Orca が戻るまで止まっている" % err,
                      confirm=True)]
    rows = res.get("worktrees") or []
    out = []
    # Orca が起動し直すと、作業の途中だったメインも done・success に戻り、手待ちと見分けられない。
    # 前の回に作業中だったメインが、起動し直したあと動いていなければ知らせる（Orca が止まっていた回は記録を変えない）。
    restart = note_restart(state, runtime, now)
    state["main_state"] = {}
    stopped = note_stops(state, rows)
    for row in rows:
        root = row.get("path")
        if not root or not os.path.isfile(os.path.join(root, ".orca", "cockpit.json")):
            continue
        name = os.path.basename(root.rstrip("/"))
        own = row.get("agents") or []
        m = pick_main(own)
        if not m:
            out.append(alert("main-missing:" + root, "「%s」のメインが Orca に見当たらない（チャットか端末が閉じた）" % name, root, confirm=True))
            continue
        state["main_state"][root] = m.get("state")
        since = m.get("stateStartedAt") or 0
        if root in restart["working"] and m.get("state") == "done" and by_restart(restart, since):
            # 再起動のあとに人が動かして終えた場合と見分けられないので、メインは起こさず人に知らせるだけにする。
            out.append(alert("main-restarted:%s:%s" % (root, since),
                             "「%s」のメインが、Orca の再起動のときに作業中だったまま止まっている（続きが要るか確かめる）" % name, root))
            continue
        stop = main_stop(m, root, now)
        if stop:
            out.append(alert("main-dead:" + root, "「%s」のメインが%s" % (name, stop), root))
            continue
        if m.get("state") == "working" and now - (m.get("updatedAt") or now) >= STALE_MS:
            out.append(alert("main-stale:" + root, "「%s」のメインが作業中のまま %d 分動きが無い" % (
                name, (now - m["updatedAt"]) // 60_000), root, confirm=True))
            continue
        if m.get("state") != "done":
            continue
        # メインが手を止めたあとに止まった worker。Orca がメインを起こしていれば、メインの stateStartedAt がそれより新しくなる。
        # 再起動でメインと一緒に付け直された worker は、止まった時刻が分からないので数えない。
        # worker は親の worktree でなく帳簿で引く（担当の worktree の下に立てた worker は窓口の孫になる）。
        panes = None
        for r in rows:
            for a in r.get("agents") or []:
                pane, started = a.get("paneKey"), stopped.get(a.get("paneKey"))
                if a is m or started is None or started <= since or by_restart(restart, since, started) or now - started < UNHANDLED_MS:
                    continue
                # 人に知らせるのは、帳簿の済んでいないタスクの worker で、窓口が立てたものだけ。担当（一緒に作る仕事の返事待ちを含む）と
                # 担当が立てた worker・質問とカードの相談のタブ・入れ替えて帳簿から外れたチャットは、止まっていても窓口の判断を待っていない。
                panes = ledger_workers(root, state) if panes is None else panes
                if pane not in panes or a.get("orcaSessionId") in panes[pane][1]:
                    continue
                title = a.get("conversationName") or a.get("displayName") or a.get("taskTitle") or os.path.basename(r.get("path", ""))
                text = "「%s」の worker「%s」（タスク %s）が%sあと、メインが %d 分動いていない" % (
                    name, title, panes[pane][0], LABEL.get(a.get("state"), a.get("state")), (now - started) // 60_000)
                out.append(alert("main-unhandled:%s:%s:%s" % (root, pane, turn_of(a)), text, root))
    return out


def note_stops(state, rows):
    """paneKey → 手を止めた worker の、今のターンで最初に見た止まった時刻。Orca は同じターンの stateStartedAt を付け直すことがある
    （2026-11-26〜27 に同じ worker を 12 回知らせた）ので、ターンが変わるまで最初の時刻を使う。作業中と Orca から消えたものは捨てる。"""
    prev, seen = state.get("stopped", {}), {}
    for r in rows:
        for a in r.get("agents") or []:
            pane, turn, started = a.get("paneKey"), turn_of(a), a.get("stateStartedAt") or 0
            if not pane or a.get("state") == "working":
                continue
            first = prev.get(pane)
            seen[pane] = [turn, min(first[1], started)] if isinstance(first, list) and first[0] == turn else [turn, started]
    state["stopped"] = seen
    return {k: v[1] for k, v in seen.items()}


def turn_of(a):
    """worker のターンの印（最後の入力と発言）。どちらも Orca に無ければ、ターンの始まった時刻で代える
    （付け直しと、5 分の間に終わった新しいターンを見分けられないので、知らせ損ねるより知らせ直すほうを採る）。"""
    said = "%s\n%s" % (a.get("prompt") or "", a.get("lastAssistantMessage") or "")
    return hashlib.sha1(said.encode("utf-8")).hexdigest()[:12] if said.strip() else str(a.get("stateStartedAt") or 0)


DISPATCH_KEYS = ("assignee_pane_key", "assignee_handle", "assignee_orca_session_id", "creator_orca_session_id", "creator_handle")


def ledger_workers(root, state):
    """帳簿の済んでいないタスクの worker の paneKey → (タスクの id, 担当の印の集合)。Task の Dispatch の受け手（assignee_pane_key）で引き、
    担当が立てた Dispatch は除く。担当の印は、帳簿の owners[] の session・terminal と、担当を立てた Task の Dispatch の受け手
    （帳簿に session が無い担当もいる。state.ts の ownerOf と同じ）。続きを send で頼んでも同じ端末・チャットに届くので、Task の Dispatch で足りる。
    Orca への問い合わせが失敗した Task は前の回の答えを使う（一回の失敗で出ている知らせを消し、次の回に同じものを知らせ直さない）。"""
    c = load(os.path.join(root, ".orca", "cockpit.json"), {})
    c = c if isinstance(c, dict) else {}
    known, seen = state.get("ledger", {}).get(root, {}), {}

    def dispatch(task):
        res = orca("orchestration", "dispatch-show", "--task", task)[0]
        d = (res or {}).get("dispatch") or {}
        seen[task] = known.get(task) if res is None else {k: d[k] for k in DISPATCH_KEYS if d.get(k)}
        return seen[task] or {}

    def task_of(x):
        w = x.get("worker") if isinstance(x, dict) else None
        return w.get("task_id") if isinstance(w, dict) else None

    leads = set()
    for o in c.get("owners") or []:
        if isinstance(o, dict):
            d = dispatch(task_of(o)) if task_of(o) else {}
            leads |= {o.get("session"), o.get("terminal"), d.get("assignee_orca_session_id"), d.get("assignee_handle"), d.get("assignee_pane_key")}
    leads.discard(None)
    out = {}
    for t in c.get("tasks") or []:
        if not task_of(t) or t.get("state") == "ok":
            continue
        d = dispatch(task_of(t))
        pane = d.get("assignee_pane_key")
        if pane and pane not in leads and not leads & {d.get("creator_orca_session_id"), d.get("creator_handle")}:
            out[pane] = (t.get("id"), leads)
    state.setdefault("ledger", {})[root] = {k: v for k, v in seen.items() if v}
    return out


def check_window(url, log, state, now):
    out = []
    for path in ("/", "/window/page.ts"):
        try:
            with urllib.request.urlopen(url.rstrip("/") + path, timeout=10) as r:
                code = r.status
        except urllib.error.HTTPError as e:
            code = e.code
        except (OSError, ValueError) as e:
            code = str(getattr(e, "reason", e))
        if code != 200:
            out.append(alert("window-http", "操縦席の窓のサーバー（%s）が %s に %s を返した" % (url, path, code), confirm=True))
            break
    if log:
        errs = new_log_errors(log, state)
        if len(errs) >= LOG_ERRORS:
            # Node のエラーは code: 'ENOENT' のような続きの行が多いので、Error: で始まる行があればそれを見せる。
            shown = next((l for l in reversed(errs) if "Error" in l), errs[-1]).strip()
            state["log_hit"] = {"at": now, "text": "操縦席の窓のサーバーのログにエラーが続いている（%s）: %s" % (log, shown[:160])}
        hit = state.get("log_hit")
        if hit and now - hit["at"] < LOG_STICKY_MS:
            out.append(alert("window-log", hit["text"]))
        else:
            state.pop("log_hit", None)
    return out


def new_log_errors(log, state):
    """前回読んだところから後のエラーの行。初めての回は位置だけ覚える（入れた直後に済んだ昔のエラーを知らせない）。
    ログが切り詰められたときは末尾だけを読む。"""
    offsets = state.setdefault("log_offsets", {})
    try:
        size = os.path.getsize(log)
    except OSError:
        return []
    start = offsets.get(log)
    if start is None:
        offsets[log] = size
        return []
    if start > size:
        start = max(0, size - LOG_TAIL)
    with open(log, "rb") as fh:
        fh.seek(start)
        text = fh.read().decode("utf-8", "replace")
    offsets[log] = size
    return [l for l in text.splitlines() if LOG_ERROR.search(l)]


def launchd_info(label):
    r = subprocess.run(["launchctl", "print", "gui/%d/%s" % (os.getuid(), label)], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    # 1 段目の字下げ（タブ 1 つ）だけを読む。中の endpoints などにも state = が出る。
    top = {}
    for line in r.stdout.splitlines():
        m = re.match(r"^\t([a-z ]+?) = (.*)$", line)
        if m and m.group(1) not in top:
            top[m.group(1)] = m.group(2).strip()
    return top


def last_line(log):
    try:
        with open(log, "rb") as fh:
            fh.seek(max(0, os.path.getsize(log) - 4096))
            lines = [l for l in fh.read().decode("utf-8", "replace").splitlines() if l.strip()]
    except OSError:
        return ""
    return lines[-1] if lines else ""


def check_jobs(jobs, services):
    out = []
    for spec, service in [(j, False) for j in jobs] + [(s, True) for s in services]:
        label, _, log = spec.partition("=")
        log = os.path.expanduser(log)
        info = launchd_info(label)
        if info is None:
            out.append(alert("job:" + label, "launchd の %s が登録されていない" % label))
            continue
        if service:
            if info.get("state") != "running":
                out.append(alert("job:" + label, "常駐の %s が動いていない（state = %s）" % (label, info.get("state"))))
            continue
        code = info.get("last exit code", "")
        if re.fullmatch(r"-?\d+", code) and code != "0":
            out.append(alert("job:" + label, "定時ジョブ %s が終わりのコード %s で失敗した（%s）" % (label, code, log or "ログなし")))
            continue
        # launchctl が last exit code = 0 を返しても、ログの最後の実行は失敗していることがある。
        line = last_line(log) if log else ""
        if line and JOB_FAILED.search(line):
            out.append(alert("job:" + label, "定時ジョブ %s のログの最後が失敗: %s" % (label, line[:200])))
    return out


def check_side(now):
    """account-failover（全席が上限・切り替えた・古い席から移せなかった claude）と orca-watch（Orca を起動し直した・止めた）が書いた知らせ。
    alerts.json の書き手をここ 1 つに保つため、帯へはここで合流させる。"""
    # どちらも知らせるべきものは書いた時点で自分で通知しているので、ここでは帯にだけ出す（quiet）。
    return [dict(alert(a["id"], a["text"]), quiet=True) for name in ("failover.json", "orca-watch.json")
            for a in load(os.path.join(HOME, name), {}).get("alerts", []) if not a.get("until") or now < a["until"]]


def notify(texts, title=None):
    cmd = os.environ.get("STALLWATCH_NOTIFY")
    title = title or ("止まっているもの %d 件" % len(texts) if len(texts) > 1 else "止まっているもの")
    body = " / ".join(texts)[:600]
    script = "display notification %s with title %s" % (json.dumps(body, ensure_ascii=False), json.dumps(title, ensure_ascii=False))
    try:
        r = subprocess.run([cmd, title, body] if cmd else ["osascript", "-e", script], capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def run(a):
    now = now_ms()
    state_path = os.path.join(HOME, "state.json")
    state = load(state_path, {})
    found = (check_mains(now, state) + check_window(a.window, a.window_log, state, now) + check_jobs(a.job, a.service)
             + check_side(now))
    seen = state.get("seen", {})
    notified = state.get("notified", {})
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    active, fresh = [], []
    for f in found:
        first = seen.get(f["id"], stamp)
        f["since"] = first
        if f["confirm"] and f["id"] not in seen:
            continue
        active.append(f)
        if f["id"] not in notified and not f.get("quiet"):
            fresh.append(f)
    sent = bool(fresh) and notify([f["text"] for f in fresh])
    # Orca に繋がらない回はメインの様子が分からないので、メインについての記録は解消と見なさずに残す。
    keep = lambda d: {k: v for k, v in d.items() if k.startswith("main-")} if any(f["id"] == "orca-down" for f in found) else {}
    state["seen"] = dict(keep(seen), **{f["id"]: f["since"] for f in found})
    state["notified"] = dict(keep(notified), **{f["id"]: notified.get(f["id"], stamp) for f in active if f["id"] in notified or sent})
    # ログには、出たもの・知らせたもの・消えたものだけを書く（出ているものを毎回全部書くと、同じ行が 5 分おきに数百回並んだ）。
    shown = state.get("active", {})
    lines = ["%s 出た: %s%s" % (stamp, f["text"], "（今回知らせた）" if sent and f in fresh else "")
             for f in active if f["id"] not in shown or (sent and f in fresh)]
    lines += ["%s 消えた: %s" % (stamp, text) for k, text in shown.items() if k not in state["seen"]]
    state["active"] = dict(keep(shown), **{f["id"]: f["text"] for f in active})
    save(state_path, state)
    save(os.path.join(COCKPIT_DIR, "alerts.json"), {
        "at": stamp, "alerts": [{"id": f["id"], "text": f["text"], "root": f["root"], "since": f["since"]} for f in active]})
    for line in lines:
        print(line)


def main():
    ap = argparse.ArgumentParser(prog="stallwatch", description=__doc__.split("\n")[0])
    ap.add_argument("--window", default="http://127.0.0.1:47231", help="操縦席の窓のサーバー")
    ap.add_argument("--window-log", help="窓のサーバーのログ。エラーの行が続いたら知らせる")
    ap.add_argument("--job", action="append", default=[], metavar="LABEL[=LOG]",
                    help="定時ジョブ。終わりのコードとログの最後の行を見る")
    ap.add_argument("--service", action="append", default=[], metavar="LABEL",
                    help="常駐のジョブ。動いているかを見る")
    a = ap.parse_args()
    failed = os.path.join(HOME, "failed")
    try:
        run(a)
    except Exception as e:  # launchd は失敗を誰にも見せないので、見張り自身の失敗も通知にする（同じ失敗は 1 回だけ）
        text = "見張り（stallwatch）自身が失敗した: %r" % e
        if load(failed, None) != text:
            notify([text])
            save(failed, text)
        raise
    if os.path.exists(failed):
        os.remove(failed)


if __name__ == "__main__":
    main()
