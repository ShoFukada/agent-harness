#!/usr/bin/env python3
"""Orca が作った worker・担当の worktree のうち、取り込み済みで使い終わったものを見つけて片付ける。

worktree-flow skill の決まりでは、メインが取り込んだその場で worktree を消す。この見回りは、そこで取りこぼしたものを拾う 2 段目。
launchd が毎晩 --apply で起こす。Orca は終わった worker の端末を閉じるが worktree は消さないので、Orca の外に置く。モデルは呼ばない。
既定は一覧を出すだけ。--apply で「消してよい」だけを消す。人が決めるもの（判断が要る）は JSON にも書き、メインの hook が読む。
"""

import argparse
import filecmp
import json
import os
import subprocess
import sys
import time

HOME = os.environ.get("WORKTREE_SWEEP_HOME") or os.path.expanduser("~/Library/Application Support/worktree-sweep")
IDLE_MS = 24 * 3600_000
# Task が終わったことを表す dispatch の state（cockpit の model.ts の SETTLED と同じ）。
# これ以外（ready など）は担当や worker がまだその worktree を使っているか、worker_done を返さずに端末を閉じた。
DISPATCH_DONE = {"succeeded", "failed", "stopped", "abandoned", "cancelled", "canceled"}
# 端末が終わったと分かる liveness。欠けた値や知らない値は、まだ生きているかもしれないものとして守る。
# unverifiable は、Orca の再起動などで端末を確かめられなくなった終わった worker に付く（2026-11-21 の一覧で 55 件中 37 件）。
NOT_LIVE = {"exited", "unverifiable"}
# ルートから写される自分用のメモと設定。ルートと同じ中身でも、確かめた後に人が保存しうるので無人では消さない。
LOCAL_NOTES = {"CLAUDE.local.md", ".claude/settings.local.json"}
REMOVE, DECIDE, KEEP = "消してよい", "判断が要る", "触らない"
# 消しても作り直せる、無視されたディレクトリの名前。ここに無い無視されたディレクトリ（postgres_data など）は固有のデータとして残す。
REGEN = {"node_modules", ".venv", "venv", "dist", "build", ".next", ".nuxt", ".output", "__pycache__", ".turbo", ".cache",
         ".pytest_cache", ".mypy_cache", ".ruff_cache", ".parcel-cache", ".svelte-kit", "coverage", ".tox", ".gradle"}


def now_ms():
    return int(time.time() * 1000)


def orca(*args, env=None):
    """(result, エラーの 1 行)。"""
    try:
        r = subprocess.run([os.environ.get("ORCA_CLI_COMMAND") or "orca"] + list(args) + ["--json"],
                           capture_output=True, text=True, timeout=120, env=env)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, str(e)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return None, " ".join((r.stderr or r.stdout or "出力なし").split())[:160]
    if not d.get("ok"):
        return None, ((d.get("error") or {}).get("message") or "ok でない")[:160]
    return d.get("result") or {}, None


def real(path):
    return os.path.realpath(path).rstrip("/")


class Dispatches:
    """worktree のパスごとの dispatch の様子。パスは登録の形と実体の形の両方を入れる。
    live: 端末が生きているか確かめられない dispatch のある worktree。state が終わっていない unverifiable も含める（Orca の再起動で確かめられないだけで、終わったとは言えない）。
    unsettled: 端末が exited なのに worker_done も停止の記録も無い dispatch（担当がチャットを閉じた・worker が落ちた）の (taskId, dispatchId) の一覧。
    finished: 終わった dispatch のある worktree。ids: その worktree の全部の dispatch の Task と Dispatch の id。task_of: Dispatch → Task。"""

    def __init__(self):
        self.live, self.finished, self.unsettled, self.ids, self.task_of = set(), set(), {}, {}, {}

    def add(self, ws, w):
        forms = {ws.rstrip("/"), real(ws)}
        task, did = (x if isinstance(x, str) and x else None for x in (w.get("taskId"), w.get("dispatchId")))
        if w.get("liveness") not in NOT_LIVE or (w.get("state") not in DISPATCH_DONE and w.get("liveness") != "exited"):
            self.live |= forms
        elif w.get("state") not in DISPATCH_DONE:
            for f in forms:
                self.unsettled.setdefault(f, set()).add((task, did))
        else:
            self.finished |= forms
        if did and task:
            self.task_of[did] = task
        for f in forms:
            self.ids.setdefault(f, set()).update(x for x in (task, did) if x)


def dispatch_paths():
    """Orca の全部の worker の dispatch を Dispatches にまとめる。読めなければ None。
    端末に紐づいた Run があると一覧がその Run に絞られるので、端末の印を外して全部の Run を読む。"""
    env = {k: v for k, v in os.environ.items() if k not in ("ORCA_TERMINAL_HANDLE", "ORCA_PANE_KEY", "ORCA_AGENT_PANE")}
    out, cursor = Dispatches(), None
    while True:
        res, err = orca("orchestration", "worker-list", "--limit", "100", *(["--cursor", cursor] if cursor else []), env=env)
        if res is None or (res.get("scope") or {}).get("source") != "all" or not isinstance(res.get("workers"), list):
            return None
        for w in res["workers"]:
            ws = (w.get("workspace") or "").split("::", 1)[-1] if isinstance(w, dict) else ""
            if not ws:
                return None
            out.add(ws, w)
        cursor = res.get("nextCursor")
        if not cursor:
            return out


def parent_dispatch(task):
    """task の Dispatch が何の続き・やり直しか（dispatch-show の follow_up_of・retry_of）。無ければ・読めなければ None。"""
    res, _ = orca("orchestration", "dispatch-show", "--task", task)
    d = (res or {}).get("dispatch") or {}
    return d.get("follow_up_of_dispatch_id") or d.get("retry_of_dispatch_id") if isinstance(d, dict) else None


def ledger_settles(main, ids, unsettled, task_of, parent=parent_dispatch):
    """worker_done を返さずに端末を閉じた dispatch（unsettled）の worktree を、窓口の帳簿（<main>/.orca/cockpit.json）で終わったと言えるか。
    Orca の上では終わったと分からないが、窓口がタスクを済（ok）・担当を done にしていれば仕事は終わっている（cockpit-write は、済にするタスクの
    worker と担当の Dispatch が動いていれば断る。R240）。次を全部満たすときだけ True:
    - その worktree の dispatch（ids）に結んだタスク・担当が全部済
    - unsettled の dispatch のどれも、自分か、続き・やり直しの元をたどった先の Task に結んだ行がある（担当に send で続きを渡すと Task が新しくなる）
    帳簿が無い・読めない・結んだ行が無いときは False。"""
    try:
        with open(os.path.join(main, ".orca", "cockpit.json"), encoding="utf-8") as fh:
            c = json.load(fh)
    except (OSError, ValueError, TypeError):
        return False
    if not isinstance(c, dict):
        return False
    done = {}
    for key, ok in (("tasks", "ok"), ("owners", "done")):
        for row in c.get(key) or []:
            w = row.get("worker") if isinstance(row, dict) else None
            for x in ((w.get("task_id"), w.get("dispatch_id")) if isinstance(w, dict) else ()):
                if isinstance(x, str) and x:
                    done[x] = done.get(x, True) and row.get("state") == ok
    if not all(done[x] for x in ids if x in done):
        return False
    for task, did in unsettled:
        seen = set()
        while not ({task, did} & done.keys()):
            seen.add(did)
            did = parent(task) if task else None
            task = task_of.get(did)
            if not did or did in seen:
                return False
        # たどった先が別の worktree の行でも、その行が済でなければ終わっていない。
        if not all(done[x] for x in {task, did} & done.keys()):
            return False
    return True


def dev_plugin_sources():
    """開発用に読み込んだ Orca のプラグインの読み込み元。登録のパスと実体のパスの両方を返す（どちらかが worktree の下なら守る）。読めなければ None。"""
    res, _ = orca("plugin", "list")
    if res is None or not isinstance(res.get("plugins"), list):
        return None
    refs = [((p.get("source") or {}).get("reference") if isinstance(p, dict) else None) for p in res["plugins"]
            if not isinstance(p, dict) or p.get("isDev")]
    if not all(isinstance(r, str) and r.strip("/") for r in refs):
        return None
    return sorted({r.rstrip("/") for r in refs} | {real(r) for r in refs})


def git(path, *args):
    return subprocess.run(["git", "-C", path] + list(args), capture_output=True, text=True)


def failed(r, what):
    return "git %s が通らない（%s）" % (what, " ".join(r.stderr.split())[:120])


def short_branch(ref):
    ref = ref or ""
    return ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else ref


def same_file(a, b):
    """a が b の写し（別の実体で中身が同じ通常ファイル）か。b が a を指すリンクなら写しではない。"""
    return all(os.path.isfile(x) and not os.path.islink(x) for x in (a, b)) and not os.path.samefile(a, b) \
        and filecmp.cmp(a, b, shallow=False)


def entries(out):
    """git status --porcelain -z の 1 件ずつ。改名とコピーの元のパスは飛ばす。"""
    parts, out_ = out.split("\0"), []
    i = 0
    while i < len(parts):
        if parts[i]:
            out_.append(parts[i])
            i += 1 if not parts[i].startswith("## ") and set(parts[i][:2]) & {"R", "C"} else 0
        i += 1
    return out_


def cache(path, rel):
    """rel が、中身が「*」だけの .gitignore を置いたディレクトリ（.pytest_cache・.husky/_ など道具が作り直す置き場）の下にあるか。"""
    d = os.path.dirname(rel)
    while d:
        try:
            with open(os.path.join(path, d, ".gitignore"), encoding="utf-8") as fh:
                if [l.strip() for l in fh if l.strip() and not l.startswith("#")] == ["*"]:
                    return True
        except (OSError, UnicodeDecodeError):
            pass
        d = os.path.dirname(d)
    return False


def inspect(row, root):
    """残っている理由を (未 commit・固有のデータ・検査の失敗など, default と比べて入っていなかった commit) に分けて返す。
    後者はブランチの PR が default にマージ済みと分かれば取り消せる（squash でマージした commit は default の祖先にならない）。
    ルートから写された CLAUDE.local.md なども未追跡のファイルとして数える（確かめたあとに人が保存しうるので、無人では消さない）。"""
    path, reasons = row["path"], []
    st = git(path, "status", "--porcelain", "-z", "--branch", "--untracked-files=all")
    if st.returncode != 0:
        return [failed(st, "status")], []
    dirty = 0
    for line in entries(st.stdout):
        rel = line[3:]
        if line.startswith("## "):
            head = line[3:].split("...", 1)[0]
            if head.startswith("HEAD (no branch)"):
                reasons.append("detached HEAD（その commit を指すブランチが無い）")
            elif head != short_branch(row.get("branch")):
                reasons.append("Orca の記録のブランチ %s と実際のブランチ %s が違う" % (short_branch(row.get("branch")), head))
        else:
            dirty += 1
    if dirty:
        reasons.append("未 commit のファイル %d 件" % dirty)
    # git の外の .env などは worktree と一緒に消えて戻せない（2026-11-21 に local-dev の worktree の .env がルートと違っていた）。
    # 無視の規則に当たったディレクトリは、REGEN の名前（node_modules・.venv など）だけを作り直せるものとして見ない。
    # それ以外（postgres_data・minio_data など）はローカルの DB などの固有のデータでありうるので、中身を見ずに残す理由にする。
    # matching にするのは、未追跡のディレクトリの中の無視されたファイル（config/.env）が config/ に畳まれないようにするため。
    ig = git(path, "status", "--porcelain", "-z", "--ignored=matching", "--untracked-files=all")
    if ig.returncode != 0:
        return reasons + [failed(ig, "status --ignored")], []
    ignored = [l[3:] for l in entries(ig.stdout) if l.startswith("!! ")]
    dirs = [d for d in ignored if d.endswith("/") and os.path.basename(d.rstrip("/")) not in REGEN and not cache(path, d.rstrip("/"))]
    own = [f for f in ignored if not f.endswith("/") and os.path.basename(f) != ".DS_Store" and not cache(path, f)
           and (f in LOCAL_NOTES or not (root and same_file(os.path.join(path, f), os.path.join(root, f))))]
    if dirs:
        reasons.append("作り直せると決めていない gitignore されたディレクトリがある（%s%s）" % ("、".join(dirs[:3]), "、ほか" if len(dirs) > 3 else ""))
    if own:
        reasons.append("gitignore されたファイルがルートと違うかルートに無い（%s%s）" % ("、".join(own[:3]), "、ほか" if len(own) > 3 else ""))
    base = default_branch(path)
    if not base:
        return reasons + ["default ブランチを決められない（origin/HEAD が無い）"], []
    # ローカルの default と origin の default のどちらか一方に全部入っていれば入っている扱いにする（PR でマージして pull 前の場合）。
    # 2 つに分かれて入っているものは、どちらにもそろっていないので入っていない扱い。タグと取り違えないよう完全な ref で比べる。
    # git cherry はマージコミットを並べないので、比較先から届かないマージコミット（競合の解決などを含みうる）は別に数える。
    found = None
    for upstream in ("refs/heads/" + base, "refs/remotes/origin/" + base):
        if git(path, "rev-parse", "--verify", "--quiet", upstream).returncode != 0:
            continue
        c, m = git(path, "cherry", "-v", upstream, "HEAD"), git(path, "rev-list", "--merges", upstream + "..HEAD")
        if c.returncode != 0 or m.returncode != 0:
            return reasons + [failed(c if c.returncode else m, "cherry")], []
        plus, merges = [l[2:] for l in c.stdout.splitlines() if not l.startswith("- ")], m.stdout.split()
        if found is None or not (plus or merges):
            found = (plus, merges)
    if found is None:
        return reasons + ["%s と比べられない（ローカルにも origin にも無い）" % base], []
    plus, merges, unmerged = found + ([],)
    if plus:
        unmerged.append("%s に無い commit %d 件（%s%s。squash で入れたものもここに出る）" % (
            base, len(plus), "、".join(c[:7] + c[40:][:40] for c in plus[:3]), "、ほか" if len(plus) > 3 else ""))
    if merges:
        unmerged.append("%s に無いマージコミット %d 件（%s）" % (base, len(merges), "、".join(c[:7] for c in merges[:3])))
    return reasons, unmerged


def default_branch(path):
    r = git(path, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD")
    return r.stdout.strip()[len("refs/remotes/origin/"):] if r.returncode == 0 and r.stdout.startswith("refs/remotes/origin/") else ""


def merged_pr(path, branch):
    """branch の PR がマージ済みなら (その PR, None)。マージのあとに commit を積んでいれば (None, 理由)、PR が無ければ (None, None)。
    gh は worktree の remote からリポジトリを決める。PR の head の SHA と今の HEAD が同じときだけマージ済みと見なす
    （同じ名前のブランチを使い回した PR や、別の fork の PR に当てないため）。積み重ねた PR の親のブランチへのマージは
    default に入ったことにならないので、default あての PR だけを見る。gh を読めなければ (None, 理由)。"""
    base = default_branch(path)
    if not base:
        return None, "default ブランチを決められず、PR を確かめていない"
    try:
        r = subprocess.run(["gh", "pr", "list", "--state", "merged", "--head", branch, "--base", base, "--json", "number,headRefOid",
                            "--limit", "20"],
                           cwd=path, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, "gh で PR を確かめられない（%s）" % str(e)[:120]
    try:
        prs = json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        prs = None
    if not isinstance(prs, list):
        return None, "gh で PR を確かめられない（%s）" % (" ".join((r.stderr or r.stdout or "出力なし").split())[:120])
    head = git(path, "rev-parse", "HEAD").stdout.strip()
    hit = next((p for p in prs if isinstance(p, dict) and head and p.get("headRefOid") == head), None)
    if hit or not prs:
        return hit, None
    p = prs[0]
    return None, "PR #%s はマージ済みだが、マージのあとに積んだ commit がある（PR の head %s・今の HEAD %s）" % (
        p.get("number"), str(p.get("headRefOid"))[:7], head[:7])


def same_branch_count(path, branch):
    """git が知っている全部の worktree（Orca の一覧の外を含む）のうち、branch を checkout しているものの数。読めなければ None。"""
    r = git(path, "worktree", "list", "--porcelain")
    return r.stdout.splitlines().count("branch refs/heads/" + branch) if r.returncode == 0 else None


def idle_ms(row, now):
    last = row.get("lastActivityAt") or 0
    if not last:
        ct = git(row["path"], "log", "-1", "--format=%ct").stdout.strip()
        last = int(ct) * 1000 if ct.isdigit() else 0
    return now - last


def classify(rows, under, dispatches, plugins, now, only=None):
    """Orca が under の下に作った worktree を (分類, 行, 理由) に分ける。only を渡すとそのパスだけを調べる。
    自動で消すのは、その worktree を使った worker・担当が終わった記録があり、取り込み済みで、固有のデータが無いものと、
    ブランチの PR がマージ済みでそのあとに commit を積んでおらず、固有のデータが無いもの（終わった記録は問わない）だけ。
    worker_done を返さずに端末を閉じた dispatch は、窓口の帳簿で結んだタスク・担当が全部済なら終わった記録として数える。"""
    by_id, top = {r.get("worktreeId"): r for r in rows}, under
    under = real(under) + "/"
    live, finished = (dispatches.live, set(dispatches.finished)) if dispatches else (None, None)
    roots = {r.get("repoId"): r["path"] for r in rows if r.get("isMainWorktree") and r.get("path")}
    seen = {}
    for r in rows:  # 取り違えは、ルートと under の外を含む Orca の全部の行で数える
        for key in (("path", real(r.get("path") or "/")), ("branch", r.get("repoId"), short_branch(r.get("branch")))):
            seen[key] = seen.get(key, 0) + 1
    targets = [r for r in rows if r.get("path") and real(r["path"]).startswith(under) and not r.get("isMainWorktree")
               and r.get("workspaceKind", "git") == "git" and r.get("hostId", "local") == "local"
               and (only is None or r["path"] == only)]
    out = []
    for r in sorted(targets, key=lambda r: r["path"]):
        path, branch = real(r["path"]), short_branch(r.get("branch"))
        forms = {path, r["path"].rstrip("/")}  # 一覧の側の登録のパスと実体のパスのどちらで書かれていても当てる
        agents = r.get("agents") or []
        if any(a.get("state") == "working" for a in agents):
            out.append((KEEP, r, ["作業中のエージェントがいる"]))
            continue
        if r.get("workspaceStatus") == "completed":
            out.append((KEEP, r, ["completed（残すと印を付けた）"]))
            continue
        if live is not None and forms & live:
            out.append((KEEP, r, ["担当か worker の dispatch が生きている"]))
            continue
        unsettled = set().union(*(dispatches.unsettled.get(f, set()) for f in forms)) if live is not None else set()
        if unsettled:
            ids = set().union(*(dispatches.ids.get(f, set()) for f in forms))
            if not ledger_settles(main_of(r, by_id, top), ids, unsettled, dispatches.task_of):
                out.append((KEEP, r, ["担当か worker の dispatch が worker_done を返さずに端末を閉じ、窓口の帳簿で結んだタスク・担当が済になっていない"]))
                continue
            finished |= forms
        src = [s for s in plugins or [] if any(s == f or s.startswith(f + "/") for f in forms)]
        if src:
            out.append((KEEP, r, ["開発用プラグインの読み込み元（%s）" % "、".join(src)]))
            continue
        if agents:
            # 担当のチャットや人が開いた会話は Orca が閉じないので、開いている間は使っている途中と見なし、人に決めさせる対象にも出さない。
            out.append((KEEP, r, ["エージェントの会話が開いている"]))
            continue
        reasons, unmerged = inspect(r, roots.get(r.get("repoId")))
        twins = same_branch_count(r["path"], branch) if branch else 1
        if seen[("path", path)] > 1 or seen[("branch", r.get("repoId"), branch)] > 1 or twins != 1:
            reasons.insert(0, "同じリポジトリに同じブランチかパスの worktree が 2 つ以上ある、または git の一覧を読めない（取り違えを避けて消さない）")
            out.append((DECIDE, r, reasons + unmerged))
            continue
        if live is None or plugins is None:
            out.append((KEEP, r, ["Orca の dispatch かプラグインの一覧を読めず、使われていないと確かめられない"] + reasons + unmerged))
            continue
        pr = None
        if branch and not reasons and (unmerged or not forms & finished):
            # squash でマージした PR のブランチは default の祖先にならず、担当の居場所や手で立てた worktree には終わった記録も無い。
            # PR がマージ済みで、そのあとに何も積んでいなければ、そのどちらが無くても片付けてよい。
            pr, why = merged_pr(r["path"], branch)
            unmerged = [] if pr else unmerged + ([why] if why else [])
        if not pr and not forms & finished:
            # 人が Orca で作ったばかりの worktree などは、取り込み済みに見えても worker の後片付けではないので消さない。
            reasons.insert(0, "この worktree を使った worker・担当が終わった記録が無い")
        reasons += unmerged
        if not reasons and not (isinstance(r.get("createdAt"), int) and now - r["createdAt"] >= IDLE_MS):
            # 終わった記録はパスで当てるので、片付けたあとに同じパスで作り直した worktree にも当たる。
            # Orca は dispatch の時刻を launchd から読める形で出さないので、作って 24 時間たつまでは消さない。
            out.append((KEEP, r, ["作られて 24 時間たっていない"]))
        elif not reasons:
            out.append((REMOVE, r, []))
        elif idle_ms(r, now) >= IDLE_MS:
            out.append((DECIDE, r, ["%d 時間動きが無い" % (idle_ms(r, now) // 3600_000)] + reasons))
        else:
            out.append((KEEP, r, ["動きが無くなって 24 時間たっていない"] + reasons))
    return out


def look(under, only=None):
    """Orca の今の様子を読んで分類する。(分類の一覧, ps の行, dispatch とプラグインの一覧を読めたか)。ps を読めなければ None。"""
    res, err = orca("worktree", "ps", "--limit", "1000")
    if res is None:
        print("orca worktree ps を読めない（%s）" % err)
        return None
    rows = res.get("worktrees") or []
    dispatches, plugins = dispatch_paths(), dev_plugin_sources()
    return classify(rows, under, dispatches, plugins, now_ms(), only), rows, dispatches is not None and plugins is not None


def remove(row):
    """cleanup.md の手順 3。(消せたか, 1 行)。"""
    path, branch = row["path"], short_branch(row.get("branch"))
    common = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
    # --force を付けないので、読み直した後に何か書かれていれば git worktree remove が断る。
    res, err = orca("worktree", "rm", "--worktree", "path:" + path, "--delete-branch")
    if res is None:
        return False, "消せなかった: %s（%s）: %s" % (path, branch, err)
    left = subprocess.run(["git", "--git-dir", common, "rev-parse", "--verify", "--quiet", "refs/heads/" + branch],
                          capture_output=True, text=True).stdout.strip() if common and branch else ""
    return True, "消した: %s（%s）%s" % (path, branch, "。ブランチは Orca が残した（%s）" % left[:12] if left else "")


def main_of(row, by_id, under):
    """親を辿って最初に当たる、under の外の worktree（窓口のワークスペース）のパス。担当の下の worker も窓口に届くようにする。"""
    seen = set()
    while row and row.get("path", "").startswith(under.rstrip("/") + "/") and row.get("worktreeId") not in seen:
        seen.add(row.get("worktreeId"))
        pid = row.get("parentWorktreeId")
        row = by_id.get(pid) or ({"path": pid.split("::", 1)[-1]} if pid else None)
    return row and row.get("path")


def entry(row, reasons, by_id, under):
    return {"path": row["path"], "repo": row.get("repo"), "branch": short_branch(row.get("branch")),
            "name": row.get("displayName"), "parent": (row.get("parentWorktreeId") or "").split("::", 1)[-1] or None,
            "main": main_of(row, by_id, under), "reasons": reasons}


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def main():
    ap = argparse.ArgumentParser(prog="worktree-sweep", description=__doc__.split("\n")[0])
    ap.add_argument("--apply", action="store_true", help="「消してよい」を消す。付けなければ一覧を出すだけ")
    ap.add_argument("--under", default=os.path.expanduser("~/orca/workspaces"),
                    help="Orca が worktree を作る場所。この下だけを見る（リポジトリのルートと、Orca 以外で作った checkout を外す）")
    a = ap.parse_args()
    now = now_ms()
    first = look(a.under)
    if first is None:
        sys.exit(1)
    rows, worktrees, readable = first
    by_id = {w.get("worktreeId"): w for w in worktrees}
    removed, decide, failed_rm, kinds = [], [], [], []
    for kind, row, reasons in rows:
        if kind == REMOVE and a.apply and readable:
            # 分類してから消すまでの間に、作業が始まったり残す印が付いたりしたものを消さないよう、その 1 件だけを読み直す。
            again = look(a.under, only=row["path"])
            if again is None or not again[2]:
                readable = False  # 読み直しで Orca を読めなくなったら、この回はもう消さない
                kind, reasons = KEEP, ["読み直しで Orca の一覧を読めなかった"]
            else:
                hit = [(k, why) for k, r, why in again[0]]
                if not hit:
                    kind, reasons = KEEP, ["読み直したら Orca の一覧に無い"]
                elif hit[0][0] != REMOVE:
                    kind, reasons = hit[0]
        elif kind == REMOVE and a.apply:
            kind, reasons = KEEP, ["この回は Orca の一覧を読めなくなったので消さない"]
        if kind == REMOVE and a.apply:
            ok, line = remove(row)
            (removed if ok else failed_rm).append(entry(row, [] if ok else [line], by_id, a.under))
            print(line)
        elif kind == REMOVE:
            print("%s: %s（%s）" % (REMOVE, row["path"], short_branch(row.get("branch"))))
        else:
            if kind == DECIDE:
                decide.append(entry(row, reasons, by_id, a.under))
            print("%s: %s（%s）: %s" % (kind, row["path"], short_branch(row.get("branch")), "・".join(reasons)))
        kinds.append(kind)
    removable = [entry(r, [], by_id, a.under) for k, r, _ in rows if k == REMOVE and not a.apply]
    save(os.path.join(HOME, "sweep.json"), {"checkedAt": now, "applied": a.apply, "readable": readable, "decide": decide,
                                             "removable": removable, "removed": removed, "notRemoved": failed_rm})
    print("%s %d 件・%s %d 件・%s %d 件%s%s" % (
        "消した" if a.apply else REMOVE, len(removed) if a.apply else len(removable), DECIDE, len(decide),
        KEEP, kinds.count(KEEP), "・消せなかった %d 件" % len(failed_rm) if failed_rm else "",
        "" if readable else "・Orca の dispatch かプラグインの一覧を読めなかったので消していない"))
    sys.exit(0 if readable and not failed_rm else 1)


if __name__ == "__main__":
    main()
