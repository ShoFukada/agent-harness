#!/usr/bin/env python3
"""Orca の worker を、Orca で今選ばれている Claude の席の端末で立てて、brief を Orca の Task として渡す。

orca orchestration worker-start --agent は起動コマンドを指定できず、worker 用の設定（sandbox）を付けられない。
そこで low-level の形（terminal create → terminal wait → worker-start --terminal）を 1 つにまとめる。
worker の完了・質問・停止は Orca が呼んだ側（Run の coordinator）に知らせる。

  orca-launch --worktree <selector> --title <短い題> --spec-file <brief> [--keep-open] [--run <run_id>] [-- <追加の引数>]
  orca-launch --worktree <selector> --cockpit-task <task id> --spec-file <brief> [--cockpit-root <root>] ...

--cockpit-task は操縦席（<root>/.orca/cockpit.json）のタスクから、題（タスクの題）・comment（「<仕事の題> › <タスク id>｜worker が作業中」）・
親の worktree（仕事の担当の worktree、担当がいなければ窓口の worktree）を決め、そのタスクを持つ依頼の済の条件と、依頼に結んだ深田さんの発言の原文
（.orca/cockpit/utterances.jsonl の全文。新しい順に上限まで）を brief の末尾に足して渡す。窓口が brief に要約し直すと細部が落ちるため。
cockpit.json は読むだけで書かない（受け取りの runId・taskId は窓口が cockpit-write で書く）。root を省くと、今のディレクトリから上に
.orca/cockpit.json を探し、無ければ git の本線（リポジトリのルート）を使う。

claude は CLAUDE_CONFIG_DIR（Orca で今選ばれている席。読めなければ呼んだ側の値）・--model opus・--settings $ORCA_WORKER_SETTINGS で起動し
（選んだ設定の絶対パスを、claude/bin の入口が読む子プロセスの $ORCA_WORKER_SETTINGS にも渡す）。
呼んだ側の値をそのまま渡さないのは、席を切り替えた直後でまだ古い席で動いている担当から立てたとき、worker が上限の席で起動するのを避けるため。
確認の画面（その席で初めて開く作業場所の「フォルダを信頼するか」・席で一度だけ出る「auto mode を既定にするか」・ログインの画面など）で
止まったら、Task を渡さずに止め、どの席で何の画面かと画面の最後の行を出す（渡すと指示の文字が「No, exit」を選ぶことがある）。
信頼を設定ファイル（.claude.json）に先に書くことはしない。
動いている claude も同じファイルを書き換え、排他の手段が無いので、競合するとほかの項目の更新を消す。
Orca のサイドバーにいつも同じ形で出るよう、端末の題と worker の作業場所の表示名を「作業｜<短い題>」に、状態を in-progress にする
（頭に仕事の形を付ける決まり。担当は「一緒に｜」「任せる｜」。呼んだ側と同じ作業場所に立てるときは、その作業場所の表示は変えない）。
頭の語も含めて上限の字数を超える名前は、何も起こさずに断る（勝手に切ると何の仕事か読めなくなり、起こしてから気づくより打ち直すほうが安い）。
頭の語と上限の値は操縦席の state.ts の WORKER_HEAD・NAME_MAX から読み、ここに写しを持たない（文書の置き場所は worktree-flow skill の references/sidebar.md）。
worker の作業場所に親が無ければ、立てる人の作業場所（ORCA_WORKTREE_ID）を親にする。親があればそのまま使う。
brief の先頭には、どの worker にも渡す決まり（WORKER_RULES のファイル）を足す。brief に既に入っていれば足さない。
"""

import argparse
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader

_loader = SourceFileLoader("stallwatch", os.path.join(os.path.dirname(os.path.realpath(__file__)), "stallwatch"))
sw = importlib.util.module_from_spec(importlib.util.spec_from_loader("stallwatch", _loader))
_loader.exec_module(sw)

WAIT_MS = 90000
ROOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
STATE_TS = os.path.join(ROOT, "orca", "plugins", "cockpit", "src", "state.ts")
# どの worker にも渡す決まりの文言の置き場所。文言はここだけが持ち、brief に人が手で書かない。
WORKER_RULES = os.path.join(ROOT, "claude", "skills", "worktree-flow", "references", "worker-rules.md")


def name_rule():
    """worker の名前の頭と上限の字数を、操縦席の state.ts から読む。"""
    with open(STATE_TS, encoding="utf-8") as fh:
        src = fh.read()
    head = re.search(r"^export const WORKER_HEAD = '([^']+)'$", src, re.M)
    limit = re.search(r"^export const NAME_MAX = (\d+)$", src, re.M)
    if not head or not limit:
        sys.exit("orca-launch: %s から WORKER_HEAD・NAME_MAX を読めない" % STATE_TS)
    return head.group(1), int(limit.group(1))


def orca(*args):
    r = subprocess.run([os.environ.get("ORCA_CLI_COMMAND") or "orca", *args, "--json"], capture_output=True, text=True)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        d = {}
    if not d.get("ok"):
        sys.stderr.write(r.stdout + r.stderr)
    return d


def seat():
    """Orca で今選ばれている Claude の席の (置き場所, メールアドレス)。システムの既定のログインなら置き場所は None。
    Orca が読めなければ呼んだ側の CLAUDE_CONFIG_DIR。"""
    r = orca("account", "list", "--agent", "claude").get("result")
    if not isinstance(r, dict) or not isinstance(r.get("accounts"), list):
        return os.environ.get("CLAUDE_CONFIG_DIR"), None
    hit = next((x for x in r["accounts"] if x.get("id") == r.get("activeAccountId")), {})
    return hit.get("home"), hit.get("email")


def stopped_at(handle, home, email, why):
    """確認の画面か入力待ちにならずに止まった端末の、席・画面の名前・画面の最後の行。"""
    lines = sw.screen_tail(handle)
    name = sw.startup_screen(lines) or why
    where = email or (os.path.basename(os.path.dirname(home)) if home else "システムの既定のログイン")
    tail = "\n".join("  | " + l for l in lines[-8:])
    return "席 %s の端末 %s が「%s」で止まっている%s" % (where, handle, name, "\n" + tail if tail else "")


def worker_settings(a):
    settings = a.settings or os.environ.get("ORCA_WORKER_SETTINGS")
    return os.path.abspath(os.path.expanduser(settings)) if settings else None


def command(a, home):
    if a.agent == "codex":
        return shlex.join(["codex", *a.extra])
    argv = ["claude", "--model", a.model]
    settings = worker_settings(a)
    if settings:
        argv += ["--settings", settings]
    # sandbox の外で動く claude/bin の入口は、denyRead を $ORCA_WORKER_SETTINGS から読むので、--settings と同じファイルを渡す
    env = (["CLAUDE_CONFIG_DIR=" + home] if home else []) + (["ORCA_WORKER_SETTINGS=" + settings] if settings else [])
    return shlex.join((["env", *env] if env else []) + argv + a.extra)


def cockpit_root(given):
    if given:
        return os.path.abspath(given)
    d = os.getcwd()
    while True:
        if os.path.isfile(os.path.join(d, ".orca", "cockpit.json")):
            return d
        up = os.path.dirname(d)
        if up == d:
            break
        d = up
    r = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True)
    return os.path.dirname(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def owner_worktree(c, stream):
    """仕事の担当の worktree の id。担当がいない・Orca に見つからなければ None。"""
    o = next((x for x in c.get("owners") or [] if x.get("stream") == stream and x.get("state") != "done"), None)
    if not o:
        return None
    if o.get("session"):
        agents = (orca("agent", "list").get("result") or {}).get("agents") or []
        hit = next((x for x in agents if x.get("orcaSessionId") == o["session"]), None)
        if hit and hit.get("worktreeId"):
            return hit["worktreeId"]
    if o.get("terminal"):
        terms = (orca("terminal", "list", "--limit", "500").get("result") or {}).get("terminals") or []
        hit = next((x for x in terms if x.get("handle") == o["terminal"]), None)
        if hit and hit.get("worktreeId"):
            return hit["worktreeId"]
    return None


SAID_LIMIT = 8000


def utterance_section(root, reqs):
    """依頼に結んだ深田さんの発言の原文を、brief に足す節にする。原文は発言の記録（hook が書く utterances.jsonl）の全文で、
    記録に無ければ依頼の引用。合わせて SAID_LIMIT 字を超えたら新しい順に残し、省いた発言の id を書く。"""
    full = {}
    try:
        # UTF-8 が途中で切れた行は、壊れた文を brief に入れないよう行ごと飛ばす
        with open(os.path.join(root, ".orca", "cockpit", "utterances.jsonl"), "rb") as fh:
            for line in fh:
                try:
                    v = json.loads(line.decode("utf-8"))
                except ValueError:
                    continue
                if isinstance(v, dict) and isinstance(v.get("id"), str) and isinstance(v.get("prompt"), str):
                    full[v["id"]] = v["prompt"]
    except OSError:
        pass
    # 全文があれば発言ごとに 1 つ、無ければ依頼ごとの引用を全部残す（同じ発言の別の箇所を引いた依頼もある）
    said = []
    for r in reqs:
        for u in r.get("utterances") or []:
            if isinstance(u, dict) and u.get("id"):
                row = (u["id"], full.get(u["id"]) or u.get("quote") or "")
                if row not in said:
                    said.append(row)
    if not said:
        return ""
    num = lambda i: int(i[2:]) if i.startswith("u-") and i[2:].isdigit() else -1
    kept, dropped, size = [], [], 0
    for i, text in sorted(said, key=lambda x: num(x[0]), reverse=True):
        if dropped or (kept and size + len(text) > SAID_LIMIT):
            label = i if i not in [k for k, _ in kept] else "%s（別の引用）" % i
            if label not in dropped:
                dropped.append(label)
            continue
        if len(text) > SAID_LIMIT:
            text = text[:SAID_LIMIT] + "\n（以下 %d 字を省いた）" % (len(text) - SAID_LIMIT)
        kept.append((i, text))
        size += len(text)
    out = ["## 深田さんの発言の原文（このタスクの依頼に結んだもの。要約し直さずに読む）"]
    if dropped:
        out.append("上限 %d 字を超えるので、古い発言 %s を省いた。全文は %s、記録に無い発言は cockpit.json の依頼の引用にある。"
                   % (SAID_LIMIT, "・".join(dropped), os.path.join(root, ".orca", "cockpit", "utterances.jsonl")))
    for i, text in reversed(kept):
        out.append("\n深田（%s）:\n%s" % (i, "\n".join("> " + l for l in text.split("\n"))))
    return "\n".join(out) + "\n"


def cockpit_plan(a):
    """--cockpit-task から題・comment・親の worktree と、済の条件・発言の原文を足した brief を決める。"""
    root = cockpit_root(a.cockpit_root)
    path = os.path.join(root or "", ".orca", "cockpit.json")
    if not root or not os.path.isfile(path):
        sys.exit("orca-launch: 操縦席（.orca/cockpit.json）が見つからない。--cockpit-root で窓口のワークスペースを渡す")
    with open(path) as fh:
        c = json.load(fh)
    t = next((x for x in c.get("tasks") or [] if x.get("id") == a.cockpit_task), None)
    if not t:
        sys.exit("orca-launch: 操縦席にタスク %s が無い（%s）" % (a.cockpit_task, path))
    s = next((x for x in c.get("streams") or [] if x.get("id") == t.get("stream")), None)
    reqs = [r for r in c.get("requests") or [] if a.cockpit_task in (r.get("tasks") or [])]
    lines = ["- %s#%d: %s" % (r["id"], i + 1, w) for r in reqs for i, w in enumerate(r.get("done_when") or [])]
    tail = ""
    if lines:
        tail += "\n\n## 済の条件（操縦席の依頼。戻りはこの番号ごとに証拠を返す）\n" + "\n".join(lines) + "\n"
    said = utterance_section(root, reqs)
    if said:
        tail += "\n\n" + said
    return {
        "title": t["title"],
        "comment": "%s › %s｜worker が作業中" % ((s or {}).get("title") or t.get("stream") or "仕事", t["id"]),
        # 担当の worktree は Orca に問い合わせるので、名前の検査を通ってから引く
        "parent": lambda: "id:" + owner if (owner := owner_worktree(c, t.get("stream"))) else "path:" + root,
        "tail": tail,
    }


def brief(spec_file, tail):
    """渡す brief のファイル。先頭にどの worker にも渡す決まりを 1 回だけ足し、末尾に操縦席から引いた節を足す。"""
    try:
        with open(WORKER_RULES, encoding="utf-8") as fh:
            rules = fh.read().strip()
    except OSError as e:
        sys.exit("orca-launch: worker に渡す決まり（%s）を読めない: %s" % (WORKER_RULES, e))
    if not rules:
        sys.exit("orca-launch: worker に渡す決まり（%s）が空" % WORKER_RULES)
    with open(spec_file, encoding="utf-8") as fh:
        body = fh.read()
    # 渡した brief で打ち直したとき（確認の画面のあとのやり直し・worker が helper に転送するとき）に二重にしない
    head = "" if rules in body else rules + "\n\n"
    fd, path = tempfile.mkstemp(prefix="brief-", suffix=".md")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(head + body.rstrip("\n") + tail + ("" if tail else "\n"))
    return path


def main():
    ap = argparse.ArgumentParser(prog="orca-launch", description=__doc__.split("\n")[0])
    ap.add_argument("--worktree", required=True, help="worker を置く worktree（orca の selector。先に orca worktree create で作る）")
    ap.add_argument("--title", help="仕事の短い日本語名。端末と作業場所は「作業｜<題>」になり、頭も含めて上限（state.ts の NAME_MAX）を超えると断るので、何の仕事かを先頭に短く。--cockpit-task のときはタスクの題")
    ap.add_argument("--cockpit-task", help="操縦席のタスクの id。題・comment・親の worktree・済の条件・深田さんの発言の原文をそこから引く")
    ap.add_argument("--cockpit-root", help="操縦席のあるワークスペースの root（省くと探す）")
    ap.add_argument("--spec-file", required=True, help="brief のファイル")
    ap.add_argument("--task-title")
    ap.add_argument("--agent", choices=("claude", "codex"), default="claude")
    ap.add_argument("--model", default="opus")
    ap.add_argument("--settings", help="既定は $ORCA_WORKER_SETTINGS")
    ap.add_argument("--keep-open", action="store_true")
    ap.add_argument("--run")
    ap.add_argument("extra", nargs=argparse.REMAINDER, help="-- のあとは起動コマンドに足す")
    a = ap.parse_args()
    a.extra = a.extra[1:] if a.extra[:1] == ["--"] else a.extra
    if not os.path.isfile(a.spec_file):
        sys.exit("orca-launch: brief が無い: %s" % a.spec_file)
    plan = cockpit_plan(a) if a.cockpit_task else None
    if plan:
        a.title = a.title or plan["title"]
    if not a.title:
        sys.exit("orca-launch: --title か --cockpit-task が要る")
    head, limit = name_rule()
    name = "%s｜%s" % (head, a.title)
    if len(name) > limit:
        sys.exit("orca-launch: 名前「%s」が %d 字で、上限の %d 字を超える。題を短くして打ち直す%s"
                 % (name, len(name), limit, "（操縦席のタスクの題を cockpit-write で直す）" if plan and a.title == plan["title"] else ""))
    a.spec_file = brief(a.spec_file, plan["tail"] if plan else "")

    wt = (orca("worktree", "show", "--worktree", a.worktree).get("result") or {}).get("worktree") or {}
    if not wt.get("path"):
        sys.exit("orca-launch: worktree %s が Orca に無い" % a.worktree)
    caller = os.environ.get("ORCA_WORKTREE_ID")
    if wt.get("id") and wt["id"] != caller:
        # 親は、操縦席のタスクなら仕事の担当（いなければ窓口）。ほかは作ったときの記録を使い、無ければ立てる人の作業場所
        if plan:
            meta = ["--comment", plan["comment"], "--parent-worktree", plan["parent"]()]
        elif wt.get("parentWorktreeId"):
            meta = []
        elif caller:
            meta = ["--parent-worktree", "id:" + caller]
        else:
            meta = []
            sys.stderr.write("orca-launch: worktree %s に親が無く、立てる人の作業場所も分からないので、親を付けていない\n" % a.worktree)
        orca("worktree", "set", "--worktree", a.worktree, "--display-name", name, "--workspace-status", "in-progress", *meta)
    home, email = seat() if a.agent == "claude" else (None, None)
    created = orca("terminal", "create", "--worktree", a.worktree, "--title", name, "--command", command(a, home))
    handle = ((created.get("result") or {}).get("terminal") or {}).get("handle")
    if not handle:
        sys.exit("orca-launch: 端末を作れなかった")
    args = ["orchestration", "worker-start", "--spec-file", a.spec_file, "--terminal", handle]
    args += ["--task-title", a.task_title] if a.task_title else []
    args += ["--keep-open"] if a.keep_open else []
    args += ["--run", a.run] if a.run else []
    retry = shlex.join(["orca", *args])
    wait = ((orca("terminal", "wait", "--terminal", handle, "--for", "tui-idle", "--timeout-ms", str(WAIT_MS))
             .get("result") or {}).get("wait") or {})
    if wait.get("blockedReason") or not wait.get("satisfied"):
        why = wait.get("blockedReason") or "%d 秒で入力待ちにならなかった（%s）" % (WAIT_MS // 1000, wait.get("status"))
        print(json.dumps({"terminal": handle, "blockedReason": wait.get("blockedReason"), "seat": email}, ensure_ascii=False))
        sys.exit("orca-launch: %s ので Task を渡していない。端末で答えてから %s で渡す（渡さないなら orca terminal close --terminal %s で閉じる）"
                 % (stopped_at(handle, home, email, why), retry, handle))
    # 席を読んでから端末ができるまでに席が切り替わると、この端末は古い席で起きている。Task を渡す前に閉じて打ち直させる。
    if a.agent == "claude" and seat()[0] != home:
        orca("terminal", "close", "--terminal", handle)
        sys.exit("orca-launch: 起動の途中で Claude の席が切り替わったので、Task を渡さずに端末を閉じた。同じ orca-launch を打ち直す")

    started = orca(*args)
    r = started.get("result") or {}
    print(json.dumps({k: r.get(k) for k in ("runId", "taskId", "dispatchId", "terminal", "state", "failedStage", "lastError")
                      if r.get(k)}, ensure_ascii=False))
    sys.exit(0 if started.get("ok") else 1)


if __name__ == "__main__":
    main()
