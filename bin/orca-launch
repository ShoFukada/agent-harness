#!/usr/bin/env python3
"""Orca の worker を、Orca で今選ばれている Claude の席の端末で立てて、brief を Orca の Task として渡す。

orca orchestration worker-start --agent は起動コマンドを指定できず、worker 用の設定（sandbox）を付けられない。
そこで low-level の形（terminal create → terminal wait → worker-start --terminal）を 1 つにまとめる。
worker の完了・質問・停止は Orca が呼んだ側（Run の coordinator）に知らせる。

  orca-launch --worktree <selector> --title <短い題> --spec-file <brief> [--keep-open] [--run <run_id>] [-- <追加の引数>]
  orca-launch --worktree <selector> --cockpit-task <task id> --spec-file <brief> [--cockpit-root <root>] ...
  orca-launch --lead <仕事の id> --name <slug> --spec-file <brief> [--agent claude|antigravity] [--cockpit-root <root>]
  orca-launch --stop <dispatch_id>

--stop は orca-launch で立てた worker を止めて端末を閉じる。worker_done を送ったあとの worker にも使う。orca-launch は端末を自分で作って
worker-start --terminal で渡すので、Orca はその端末を外のもの（worker-show の terminalResource.ownershipState が external）と見て、
worker-stop でも worker_done のあとの自動の片付け（worker-release）でも閉じない。worker-stop は、動いている worker には
stop_unknown（The worker terminal is external）を、報告を済ませた worker には alreadySettled・processAction none を返す。
どちらでも、外の端末ならその Dispatch の端末を terminal close で閉じる（端末がもう無い terminal_handle_stale は閉じたものとして扱う）。
worker-stop が processAction closed_agent_terminal を返したら Orca が閉じたので閉じない。外の端末でないもの（orchestration dispatch で
渡した端末・Orca が持つ端末）と、同じ Run で同じ端末に済んでいない別の Dispatch があるもの（続きの Dispatch が同じ端末に来る）も閉じず、
closed: false と理由を出して 0 で終える。stop_unknown のうち The recorded worker process is exited などは、Orca が端末を生きていないと
見た返事で、止めたと言えないので 1 で終える。

--lead は仕事（streams[]）の担当を立てる（t159）。表示名とチャットの題を「<形の頭>｜<仕事の題>」にし（頭は state.ts の NAME_HEAD を仕事の form で引く）、
窓口の子の worktree（new-child）に立て、帳簿の owners[] にそのまま書ける担当の行（session か terminal と、受け取り worker）を出す。
担当は既定で Claude（Orca のチャット）。--agent antigravity は Gemini（agy）で立てる。Orca は agy をチャットで開けず端末で開くので、
行には session ではなく端末の handle（terminal）を書く。agy では Gemini のモデルだけを使う（R108。判定は claude/bin/agy_launch.py の pin_gemini）。
形の無い仕事・見張る仕事・開いた担当がいる仕事には立てない。担当の形を手で打つと、帳簿の形と食い違う（2026-11-25 の整理のあと、
任せる仕事に「一緒に｜」の担当がいた）。
--cockpit-task は、タスクの仕事に形が無い・見張る仕事なら断る。一緒に作る仕事は担当が --run を付けて立てるときだけ通し、窓口が直接立てるのは断る
（一緒に作る仕事の作業は担当のチャットで深田さんと進める。R145）。操縦席のある窓口（今のディレクトリから上に .orca/cockpit.json がある）からは、
--run を付けない --title だけの起動を断る（帳簿のタスクに結ばない worker は、帳簿と Orca が食い違う元になる）。

--cockpit-task は操縦席（<root>/.orca/cockpit.json）のタスクから、題（タスクの題）・comment（「<仕事の題> › <タスク id>｜worker が作業中」）・
親の worktree（仕事の担当の worktree、担当がいなければ窓口の worktree）を決め、そのタスクを持つ依頼の済の条件と、依頼に結んだ深田さんの発言の原文
（.orca/cockpit/utterances.jsonl の全文。新しい順に上限まで）を brief の末尾に足して渡す。窓口が brief に要約し直すと細部が落ちるため。
cockpit.json は読むだけで書かない（受け取りの runId・taskId は窓口が cockpit-write で書く）。root を省くと、今のディレクトリから上に
.orca/cockpit.json を探し、無ければ git の本線（リポジトリのルート）を使う。

claude は CLAUDE_CONFIG_DIR（Orca で今選ばれている席。読めなければ呼んだ側の値）・--model opus・--settings $ORCA_WORKER_SETTINGS で起動し
（選んだ設定の絶対パスを、claude/bin の入口が読む子プロセスの $ORCA_WORKER_SETTINGS にも渡す）。
呼んだ側の値をそのまま渡さないのは、席を切り替えた直後でまだ古い席で動いている担当から立てたとき、worker が上限の席で起動するのを避けるため。
確認の画面（その席で初めて開く作業場所の「フォルダを信頼するか」・席で一度だけ出る「auto mode を既定にするか」・ログインの画面など）で
止まったら、Task を渡さずに止め、どの席で何の画面かと画面の最後の行を出す（渡すと指示の文字が「No, exit」を選ぶことがある）。
信頼を設定ファイル（.claude.json）に先に書くことはしない。
動いている claude も同じファイルを書き換え、排他の手段が無いので、競合するとほかの項目の更新を消す。
Orca のサイドバーにいつも同じ形で出るよう、端末の題と worker の作業場所の表示名を「作業｜<短い題>」に、状態を in-progress にする
（頭に仕事の形を付ける決まり。担当の「一緒に｜」「任せる｜」は --lead が仕事の形から付ける。呼んだ側と同じ作業場所に立てるときは、その作業場所の表示は変えない）。
頭の語も含めて上限の字数を超える名前は、何も起こさずに断る（勝手に切ると何の仕事か読めなくなり、起こしてから気づくより打ち直すほうが安い）。
頭の語と上限の値は操縦席の state.ts の WORKER_HEAD・NAME_MAX から読み、ここに写しを持たない（文書の置き場所は worktree-flow skill の references/sidebar.md）。
worker の作業場所に親が無ければ、立てる人の作業場所（ORCA_WORKTREE_ID）を親にする。親があればそのまま使う。
brief の先頭には、どの worker にも渡す決まり（WORKER_RULES のファイル）を足す。brief に既に入っていれば足さない。
"""

import argparse
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from importlib.machinery import SourceFileLoader

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "claude", "bin"))
import agy_launch  # noqa: E402

_loader = SourceFileLoader("stallwatch", os.path.join(os.path.dirname(os.path.realpath(__file__)), "stallwatch"))
sw = importlib.util.module_from_spec(importlib.util.spec_from_loader("stallwatch", _loader))
_loader.exec_module(sw)

WAIT_MS = 90000
LEAD_MODEL = "claude-opus-5-5"
ROOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
STATE_TS = os.path.join(ROOT, "orca", "plugins", "cockpit", "src", "state.ts")
# どの worker にも渡す決まりの文言の置き場所。文言はここだけが持ち、brief に人が手で書かない。
WORKER_RULES = os.path.join(ROOT, "claude", "skills", "worktree-flow", "references", "worker-rules.md")


def name_rule():
    """worker の名前の頭と上限の字数を、操縦席の state.ts から読む。"""
    with open(STATE_TS, encoding="utf-8") as fh:
        src = fh.read()
    head = re.search(r"^export const WORKER_HEAD = '([^']+)'$", src, re.M)
    limit = re.search(r"^export const NAME_MAX = (\d+)$", src, re.M)
    if not head or not limit:
        sys.exit("orca-launch: %s から WORKER_HEAD・NAME_MAX を読めない" % STATE_TS)
    return head.group(1), int(limit.group(1))


def form_heads():
    """仕事の形 → 担当の名前の頭（state.ts の NAME_HEAD）。"""
    with open(STATE_TS, encoding="utf-8") as fh:
        src = fh.read()
    m = re.search(r"^export const NAME_HEAD: Record<StreamForm, string> = \{([^}]*)\}$", src, re.M)
    heads = dict(re.findall(r"(\w+): '([^']+)'", m.group(1))) if m else {}
    if not heads:
        sys.exit("orca-launch: %s から NAME_HEAD を読めない" % STATE_TS)
    return heads


def orca(*args):
    r = subprocess.run([os.environ.get("ORCA_CLI_COMMAND") or "orca", *args, "--json"], capture_output=True, text=True)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        d = {}
    if not d.get("ok"):
        sys.stderr.write(r.stdout + r.stderr)
    return d


def seat():
    """Orca で今選ばれている Claude の席の (置き場所, メールアドレス)。システムの既定のログインなら置き場所は None。
    Orca が読めなければ呼んだ側の CLAUDE_CONFIG_DIR。"""
    r = orca("account", "list", "--agent", "claude").get("result")
    if not isinstance(r, dict) or not isinstance(r.get("accounts"), list):
        return os.environ.get("CLAUDE_CONFIG_DIR"), None
    hit = next((x for x in r["accounts"] if x.get("id") == r.get("activeAccountId")), {})
    return hit.get("home"), hit.get("email")


def stopped_at(handle, home, email, why):
    """確認の画面か入力待ちにならずに止まった端末の、席・画面の名前・画面の最後の行。"""
    lines = sw.screen_tail(handle)
    name = sw.startup_screen(lines) or why
    where = email or (os.path.basename(os.path.dirname(home)) if home else "システムの既定のログイン")
    tail = "\n".join("  | " + l for l in lines[-8:])
    return "席 %s の端末 %s が「%s」で止まっている%s" % (where, handle, name, "\n" + tail if tail else "")


def worker_settings(a):
    settings = a.settings or os.environ.get("ORCA_WORKER_SETTINGS")
    return os.path.abspath(os.path.expanduser(settings)) if settings else None


def command(a, home):
    if a.agent == "codex":
        return shlex.join(["codex", *a.extra])
    argv = ["claude", "--model", a.model]
    settings = worker_settings(a)
    if settings:
        argv += ["--settings", settings]
    # sandbox の外で動く claude/bin の入口は、denyRead を $ORCA_WORKER_SETTINGS から読むので、--settings と同じファイルを渡す
    env = (["CLAUDE_CONFIG_DIR=" + home] if home else []) + (["ORCA_WORKER_SETTINGS=" + settings] if settings else [])
    return shlex.join((["env", *env] if env else []) + argv + a.extra)


def own_cockpit():
    """今のディレクトリから上にある操縦席の root（窓口の居場所）。担当・worker の worktree には操縦席が無い（git に入れない）。"""
    d = os.getcwd()
    while True:
        if os.path.isfile(os.path.join(d, ".orca", "cockpit.json")):
            return d
        up = os.path.dirname(d)
        if up == d:
            return None
        d = up


def cockpit_root(given):
    if given:
        return os.path.abspath(given)
    here = own_cockpit()
    if here:
        return here
    r = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True)
    return os.path.dirname(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


CHAT_HANDLE = "orca_session_id:"


def as_written(o):
    """担当の行を書く道具が受ける形にする。orca agent launch --surface chat の handle（orca_session_id:<id>）を terminal に書いた前の行は、
    窓の読み込み（model.ts の parseCockpit）と同じく session に読み替える（書く道具はこの terminal を断るため。t183）。"""
    t = o.get("terminal")
    if isinstance(t, str) and t.startswith(CHAT_HANDLE) and not o.get("session"):
        return {**{k: v for k, v in o.items() if k != "terminal"}, "session": t[len(CHAT_HANDLE):]}
    return o


def owner_worktree(c, stream):
    """仕事の担当の worktree の id。担当がいない・Orca に見つからなければ None。"""
    o = next((x for x in c.get("owners") or [] if x.get("stream") == stream and x.get("state") != "done"), None)
    if not o:
        return None
    o = as_written(o)
    if o.get("session"):
        agents = (orca("agent", "list").get("result") or {}).get("agents") or []
        hit = next((x for x in agents if x.get("orcaSessionId") == o["session"]), None)
        if hit and hit.get("worktreeId"):
            return hit["worktreeId"]
    if o.get("terminal"):
        terms = (orca("terminal", "list", "--limit", "500").get("result") or {}).get("terminals") or []
        hit = next((x for x in terms if x.get("handle") == o["terminal"]), None)
        if hit and hit.get("worktreeId"):
            return hit["worktreeId"]
    return None


SAID_LIMIT = 8000


def utterance_section(root, reqs):
    """依頼に結んだ深田さんの発言の原文を、brief に足す節にする。原文は発言の記録（hook が書く utterances.jsonl）の全文で、
    記録に無ければ依頼の引用。合わせて SAID_LIMIT 字を超えたら新しい順に残し、省いた発言の id を書く。"""
    full = {}
    try:
        # UTF-8 が途中で切れた行は、壊れた文を brief に入れないよう行ごと飛ばす
        with open(os.path.join(root, ".orca", "cockpit", "utterances.jsonl"), "rb") as fh:
            for line in fh:
                try:
                    v = json.loads(line.decode("utf-8"))
                except ValueError:
                    continue
                if isinstance(v, dict) and isinstance(v.get("id"), str) and isinstance(v.get("prompt"), str):
                    full[v["id"]] = v["prompt"]
    except OSError:
        pass
    # 全文があれば発言ごとに 1 つ、無ければ依頼ごとの引用を全部残す（同じ発言の別の箇所を引いた依頼もある）
    said = []
    for r in reqs:
        for u in r.get("utterances") or []:
            if isinstance(u, dict) and u.get("id"):
                row = (u["id"], full.get(u["id"]) or u.get("quote") or "")
                if row not in said:
                    said.append(row)
    if not said:
        return ""
    num = lambda i: int(i[2:]) if i.startswith("u-") and i[2:].isdigit() else -1
    kept, dropped, size = [], [], 0
    for i, text in sorted(said, key=lambda x: num(x[0]), reverse=True):
        if dropped or (kept and size + len(text) > SAID_LIMIT):
            label = i if i not in [k for k, _ in kept] else "%s（別の引用）" % i
            if label not in dropped:
                dropped.append(label)
            continue
        if len(text) > SAID_LIMIT:
            text = text[:SAID_LIMIT] + "\n（以下 %d 字を省いた）" % (len(text) - SAID_LIMIT)
        kept.append((i, text))
        size += len(text)
    out = ["## 深田さんの発言の原文（このタスクの依頼に結んだもの。要約し直さずに読む）"]
    if dropped:
        out.append("上限 %d 字を超えるので、古い発言 %s を省いた。全文は %s、記録に無い発言は cockpit.json の依頼の引用にある。"
                   % (SAID_LIMIT, "・".join(dropped), os.path.join(root, ".orca", "cockpit", "utterances.jsonl")))
    for i, text in reversed(kept):
        out.append("\n深田（%s）:\n%s" % (i, "\n".join("> " + l for l in text.split("\n"))))
    return "\n".join(out) + "\n"


def cockpit_plan(a):
    """--cockpit-task から題・comment・親の worktree と、済の条件・発言の原文を足した brief を決める。"""
    root = cockpit_root(a.cockpit_root)
    path = os.path.join(root or "", ".orca", "cockpit.json")
    if not root or not os.path.isfile(path):
        sys.exit("orca-launch: 操縦席（.orca/cockpit.json）が見つからない。--cockpit-root で窓口のワークスペースを渡す")
    with open(path) as fh:
        c = json.load(fh)
    t = next((x for x in c.get("tasks") or [] if x.get("id") == a.cockpit_task), None)
    if not t:
        sys.exit("orca-launch: 操縦席にタスク %s が無い（%s）" % (a.cockpit_task, path))
    s = next((x for x in c.get("streams") or [] if x.get("id") == t.get("stream")), None)
    form = (s or {}).get("form")
    if form not in ("delegate", "cowork"):
        sys.exit("orca-launch: タスク %s の仕事 %s は%s。worker を立てる前に仕事の形を決める（cockpit skill の「仕事の形」）"
                 % (a.cockpit_task, t.get("stream"), "見張る仕事で、worker を立てない" if form == "watch" else "形（form）が決まっていない"))
    if form == "cowork" and not a.run:
        sys.exit("orca-launch: タスク %s の仕事 %s は一緒に作る仕事。作業は担当のチャットで進めるので、窓口は worker を立てず担当に send で渡す"
                 "（担当がいなければ orca-launch --lead %s で立てる）" % (a.cockpit_task, t.get("stream"), t.get("stream")))
    lead = None
    if form == "cowork":
        # 一緒に作る仕事の worker は、その仕事の開いた担当が自分の worktree から立てるものだけ（別の Run を渡して窓口が立てるのを止める）。
        lead = owner_worktree(c, t.get("stream"))
        if not lead or lead != os.environ.get("ORCA_WORKTREE_ID"):
            sys.exit("orca-launch: タスク %s の仕事 %s は一緒に作る仕事で、worker を立てられるのはその仕事の開いた担当（の worktree）だけ%s"
                     % (a.cockpit_task, t.get("stream"), "" if lead else "。担当がいないか、Orca で担当の居場所を引けない"))
    reqs = [r for r in c.get("requests") or [] if a.cockpit_task in (r.get("tasks") or [])]
    lines = ["- %s#%d: %s" % (r["id"], i + 1, w) for r in reqs for i, w in enumerate(r.get("done_when") or [])]
    tail = ""
    if lines:
        tail += "\n\n## 済の条件（操縦席の依頼。戻りはこの番号ごとに証拠を返す）\n" + "\n".join(lines) + "\n"
    said = utterance_section(root, reqs)
    if said:
        tail += "\n\n" + said
    return {
        "title": t["title"],
        "comment": "%s › %s｜worker が作業中" % ((s or {}).get("title") or t.get("stream") or "仕事", t["id"]),
        # 担当の worktree は Orca に問い合わせるので、名前の検査を通ってから引く
        # 一緒に作る仕事は照合に使った担当の worktree をそのまま親にする（引き直して一覧から消えていると窓口の root になる）。
        "parent": lambda: "id:" + owner if (owner := lead or owner_worktree(c, t.get("stream"))) else "path:" + root,
        "tail": tail,
    }


def brief(spec_file, tail):
    """渡す brief のファイル。先頭にどの worker にも渡す決まりを 1 回だけ足し、末尾に操縦席から引いた節を足す。"""
    try:
        with open(WORKER_RULES, encoding="utf-8") as fh:
            rules = fh.read().strip()
    except OSError as e:
        sys.exit("orca-launch: worker に渡す決まり（%s）を読めない: %s" % (WORKER_RULES, e))
    if not rules:
        sys.exit("orca-launch: worker に渡す決まり（%s）が空" % WORKER_RULES)
    with open(spec_file, encoding="utf-8") as fh:
        body = fh.read()
    # 渡した brief で打ち直したとき（確認の画面のあとのやり直し・worker が helper に転送するとき）に二重にしない
    head = "" if rules in body else rules + "\n\n"
    fd, path = tempfile.mkstemp(prefix="brief-", suffix=".md")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(head + body.rstrip("\n") + tail + ("" if tail else "\n"))
    return path


def endpoint_of(dispatch, tries=15):
    """担当の話し相手の場所。チャットなら {"session": <id>}（worker-show --full の endpointIncarnation「structured:<id>」）、
    端末なら {"terminal": <term_…>}。チャットの handle（structworker_…）は端末ではないので terminal にしない。できるまで少し待つ。"""
    for i in range(tries):
        r = (orca("orchestration", "worker-show", "--dispatch", dispatch, "--full").get("result") or {})
        res = r.get("terminalResource") or {}
        inc = res.get("endpointIncarnation") or ""
        if inc.startswith("structured:"):
            return {"session": inc[len("structured:"):]}
        handle = res.get("terminalHandle") or (r.get("worker") or {}).get("agentTerminalHandle") or ""
        if handle.startswith("term_"):
            return {"terminal": handle}
        if i + 1 < tries:
            time.sleep(2)
    return {}


def lead_model(a):
    """担当のモデル。Claude は既定 LEAD_MODEL、Gemini（agy）は既定 agy_launch.DEFAULT_MODEL で、Gemini 以外は断る（R108）。"""
    if a.agent == "claude":
        return a.model or LEAD_MODEL
    if a.agent != "antigravity":
        sys.exit("orca-launch: --lead の --agent は claude か antigravity")
    try:
        args = agy_launch.pin_gemini(["agy"] + (["--model", a.model] if a.model else []))
    except ValueError as e:
        sys.exit("orca-launch: %s" % e)
    return args[args.index("--model") + 1]


def start_lead(a):
    """仕事の担当を立て、帳簿の owners[] に書く担当の行を出す。"""
    root = cockpit_root(a.cockpit_root)
    path = os.path.join(root or "", ".orca", "cockpit.json")
    if not root or not os.path.isfile(path):
        sys.exit("orca-launch: 操縦席（.orca/cockpit.json）が見つからない。--cockpit-root で窓口のワークスペースを渡す")
    with open(path) as fh:
        c = json.load(fh)
    s = next((x for x in c.get("streams") or [] if x.get("id") == a.lead), None)
    if not s:
        sys.exit("orca-launch: 操縦席に仕事 %s が無い（%s）" % (a.lead, path))
    # 形を変えるときは新しい形を --form で渡し、仕事の form と担当の行を同じ書き込みで書く（先に form だけ変えると、担当のいない一緒に作る仕事になる）。
    form = a.form or s.get("form")
    if form not in ("delegate", "cowork"):
        sys.exit("orca-launch: 仕事 %s は%s。担当を立てる前に仕事の形（delegate か cowork）を cockpit-write で決める"
                 % (a.lead, "見張る仕事で、担当を置かない" if form == "watch" else "形（form）が決まっていない"))
    owners = c.get("owners") or []
    have = next((o for o in owners if o.get("stream") == a.lead and o.get("state") != "done"), None)
    if have and have.get("id") != a.replace:
        sys.exit("orca-launch: 仕事 %s には担当 %s がいる。続きは orca orchestration send --to dispatch:<担当の今の Dispatch> で渡す"
                 "（立て直すなら --replace %s を付け、出た 2 行を同じ書き込みで書く）" % (a.lead, have.get("id"), have.get("id")))
    if a.replace and not have:
        sys.exit("orca-launch: 仕事 %s に開いた担当 %s がいない（--replace は今の担当を立て直すときだけ）" % (a.lead, a.replace))
    if not a.name or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", a.name):
        sys.exit("orca-launch: --lead には --name <英小文字・数字・- の slug> が要る（担当の worktree の名前。例 backlog-lead）")
    model = lead_model(a)
    _, limit = name_rule()
    name = "%s｜%s" % (form_heads()[form], s.get("title") or a.lead)
    if len(name) > limit:
        sys.exit("orca-launch: 名前「%s」が %d 字で、上限の %d 字を超える。仕事の題を cockpit-write で短くして打ち直す" % (name, len(name), limit))
    started = orca("orchestration", "worker-start", "--spec-file", a.spec_file, "--worktree", "new-child", "--name", a.name,
                   "--display-name", name, "--agent", a.agent, "--model", model, "--keep-open", "--task-title", name)
    r = started.get("result") or {}
    if not started.get("ok") or not r.get("runId") or not r.get("taskId"):
        sys.exit("orca-launch: 担当を立てられなかった")
    where = endpoint_of(r["dispatchId"]) if r.get("dispatchId") else {}
    nums = [int(m.group(1)) for o in owners if (m := re.fullmatch(r"o(\d+)", str(o.get("id"))))]
    row = {"id": "o%d" % (max(nums, default=0) + 1), "title": s.get("title") or a.lead, "stream": a.lead, "agent": a.agent,
           **where, "worker": {"run_id": r["runId"], "task_id": r["taskId"]}, "state": "open"}
    out = {"runId": r["runId"], "taskId": r["taskId"], "dispatchId": r.get("dispatchId"), "owner": row}
    if have:
        out["replaced"] = {**as_written(have), "state": "done"}
    if form != s.get("form"):
        # 書く道具は仕事の行を丸ごと置き換えるので、今の行に形だけを変えたものを出す。
        out["stream"] = {**s, "form": form}
    print(json.dumps(out, ensure_ascii=False))
    if not where:
        sys.exit("orca-launch: 担当は立ったが、話し相手の場所を引けなかった。orca worktree ps --json の %s で、チャットなら agents[].orcaSessionId を owner の session に、"
                 "端末なら term_… を owner の terminal に足して書く" % a.name)
    sys.exit(0)


SETTLED = ("succeeded", "failed", "stopped", "abandoned")


def stop_worker(dispatch):
    """worker-stop で止め、Orca が端末を閉じなかったら、その Dispatch の外の端末を閉じる。"""
    r = orca("orchestration", "worker-stop", "--dispatch", dispatch)
    said = json.dumps(r, ensure_ascii=False)
    result = r.get("result") or {"dispatchId": dispatch}
    if r.get("ok") and "stop_unknown" not in said:
        if result.get("processAction") == "closed_agent_terminal":
            # worker-stop のヘルプ: Orca が閉じたので terminal close を重ねない
            print(json.dumps(result, ensure_ascii=False))
            sys.exit(0)
    elif "stop_unknown" not in said or "terminal is external" not in said:
        # 「The recorded worker process is exited」などは、Orca が端末を生きていないと見た返事。閉じる相手が無く、止めたとも言えないので失敗にする
        sys.exit("orca-launch: worker-stop が %s を止められなかった" % dispatch)
    shown = orca("orchestration", "worker-show", "--dispatch", dispatch, "--full").get("result") or {}
    res = shown.get("terminalResource") or {}
    if res.get("ownershipState") != "external":
        # Orca が持つ端末は Orca が片付け、orchestration dispatch で渡した端末は人やほかのエージェントのもの
        print(json.dumps({**result, "closed": False, "reason": "terminal_not_external"}, ensure_ascii=False))
        sys.exit(0)
    handle = res.get("terminalHandle") or (shown.get("terminal") or {}).get("handle") or (shown.get("worker") or {}).get("agentTerminalHandle")
    if not handle:
        sys.exit("orca-launch: %s の端末が分からないので閉じていない（orca orchestration worker-show --dispatch %s --full で確かめる）" % (dispatch, dispatch))
    # 報告を済ませた worker の端末には、続きの Dispatch が同じ端末で来る（2026-11-28 の term_885487e5 は ctx_d8a2a07d4f10 のあと ctx_bf42b7ec6f92 を受けた）
    run = (shown.get("dispatch") or {}).get("runId")
    workers = (orca("orchestration", "worker-list", *(["--run", run] if run else []), "--limit", "100").get("result") or {}).get("workers") or []
    busy = [w["dispatchId"] for w in workers if w.get("terminal") == handle and w.get("dispatchId") != dispatch and w.get("state") not in SETTLED]
    if busy:
        print(json.dumps({**result, "terminal": handle, "closed": False, "reason": "terminal_in_use", "usedBy": busy}, ensure_ascii=False))
        sys.exit(0)
    closed = orca("terminal", "close", "--terminal", handle)
    if not closed.get("ok") and (closed.get("error") or {}).get("code") != "terminal_handle_stale":
        sys.exit("orca-launch: %s の端末 %s を閉じられなかった" % (dispatch, handle))
    print(json.dumps({**result, "terminal": handle, "closed": True, **({} if closed.get("ok") else {"alreadyGone": True})}, ensure_ascii=False))
    sys.exit(0)


def main():
    ap = argparse.ArgumentParser(prog="orca-launch", description=__doc__.split("\n")[0])
    ap.add_argument("--stop", metavar="DISPATCH", help="orca-launch で立てた worker を止め、端末を閉じる")
    ap.add_argument("--worktree", help="worker を置く worktree（orca の selector。先に orca worktree create で作る）。--lead では使わない")
    ap.add_argument("--lead", help="担当を立てる仕事の id（streams[]）。表示名の頭は仕事の形から決め、owners[] に書く行を出す")
    ap.add_argument("--name", help="--lead の担当の worktree の名前（slug）")
    ap.add_argument("--form", choices=("delegate", "cowork"), help="--lead で、仕事の形を変えながら担当を立てる（出た stream の行を担当の行と同じ書き込みで書く）")
    ap.add_argument("--replace", help="--lead で、今の担当（owners の id）を立て直す（出た replaced の行と新しい担当の行を同じ書き込みで書く）")
    ap.add_argument("--title", help="仕事の短い日本語名。端末と作業場所は「作業｜<題>」になり、頭も含めて上限（state.ts の NAME_MAX）を超えると断るので、何の仕事かを先頭に短く。--cockpit-task のときはタスクの題")
    ap.add_argument("--cockpit-task", help="操縦席のタスクの id。題・comment・親の worktree・済の条件・深田さんの発言の原文をそこから引く")
    ap.add_argument("--cockpit-root", help="操縦席のあるワークスペースの root（省くと探す）")
    ap.add_argument("--spec-file", help="brief のファイル（--stop のほかは要る）")
    ap.add_argument("--task-title")
    ap.add_argument("--agent", choices=("claude", "codex", "antigravity"), default="claude",
                    help="antigravity（Gemini の agy）は --lead だけ。担当は Orca の端末に立つ")
    ap.add_argument("--model", help="既定は worker が opus、担当が %s（antigravity は %s。Gemini 以外は断る）"
                    % (LEAD_MODEL, agy_launch.DEFAULT_MODEL))
    ap.add_argument("--settings", help="既定は $ORCA_WORKER_SETTINGS")
    ap.add_argument("--keep-open", action="store_true")
    ap.add_argument("--run")
    ap.add_argument("extra", nargs=argparse.REMAINDER, help="-- のあとは起動コマンドに足す")
    a = ap.parse_args()
    a.extra = a.extra[1:] if a.extra[:1] == ["--"] else a.extra
    if a.stop:
        stop_worker(a.stop)
    if not a.spec_file:
        sys.exit("orca-launch: --spec-file が要る")
    if not os.path.isfile(a.spec_file):
        sys.exit("orca-launch: brief が無い: %s" % a.spec_file)
    if a.lead:
        start_lead(a)
    if a.agent == "antigravity":
        sys.exit("orca-launch: --agent antigravity は --lead で担当を立てるときだけ（worker は claude か codex）")
    if not a.worktree:
        sys.exit("orca-launch: --worktree が要る（担当を立てるなら --lead）")
    a.model = a.model or "opus"
    if not a.cockpit_task and not a.run and own_cockpit():
        sys.exit("orca-launch: 操縦席のある窓口からは --cockpit-task <タスクの id> で立てる（帳簿のタスクに結ばない worker は、帳簿と Orca が食い違う元になる）。"
                 "タスクが無ければ、先に仕事の形を決めてタスクを cockpit-write で書く")
    plan = cockpit_plan(a) if a.cockpit_task else None
    if plan:
        a.title = a.title or plan["title"]
    if not a.title:
        sys.exit("orca-launch: --title か --cockpit-task が要る")
    head, limit = name_rule()
    name = "%s｜%s" % (head, a.title)
    if len(name) > limit:
        sys.exit("orca-launch: 名前「%s」が %d 字で、上限の %d 字を超える。題を短くして打ち直す%s"
                 % (name, len(name), limit, "（操縦席のタスクの題を cockpit-write で直す）" if plan and a.title == plan["title"] else ""))
    a.spec_file = brief(a.spec_file, plan["tail"] if plan else "")

    wt = (orca("worktree", "show", "--worktree", a.worktree).get("result") or {}).get("worktree") or {}
    if not wt.get("path"):
        sys.exit("orca-launch: worktree %s が Orca に無い" % a.worktree)
    caller = os.environ.get("ORCA_WORKTREE_ID")
    if wt.get("id") and wt["id"] != caller:
        # 親は、操縦席のタスクなら仕事の担当（いなければ窓口）。ほかは作ったときの記録を使い、無ければ立てる人の作業場所
        if plan:
            meta = ["--comment", plan["comment"], "--parent-worktree", plan["parent"]()]
        elif wt.get("parentWorktreeId"):
            meta = []
        elif caller:
            meta = ["--parent-worktree", "id:" + caller]
        else:
            meta = []
            sys.stderr.write("orca-launch: worktree %s に親が無く、立てる人の作業場所も分からないので、親を付けていない\n" % a.worktree)
        orca("worktree", "set", "--worktree", a.worktree, "--display-name", name, "--workspace-status", "in-progress", *meta)
    home, email = seat() if a.agent == "claude" else (None, None)
    created = orca("terminal", "create", "--worktree", a.worktree, "--title", name, "--command", command(a, home))
    handle = ((created.get("result") or {}).get("terminal") or {}).get("handle")
    if not handle:
        sys.exit("orca-launch: 端末を作れなかった")
    args = ["orchestration", "worker-start", "--spec-file", a.spec_file, "--terminal", handle]
    args += ["--task-title", a.task_title] if a.task_title else []
    args += ["--keep-open"] if a.keep_open else []
    args += ["--run", a.run] if a.run else []
    retry = shlex.join(["orca", *args])
    wait = ((orca("terminal", "wait", "--terminal", handle, "--for", "tui-idle", "--timeout-ms", str(WAIT_MS))
             .get("result") or {}).get("wait") or {})
    if wait.get("blockedReason") or not wait.get("satisfied"):
        why = wait.get("blockedReason") or "%d 秒で入力待ちにならなかった（%s）" % (WAIT_MS // 1000, wait.get("status"))
        print(json.dumps({"terminal": handle, "blockedReason": wait.get("blockedReason"), "seat": email}, ensure_ascii=False))
        sys.exit("orca-launch: %s ので Task を渡していない。端末で答えてから %s で渡す（渡さないなら orca terminal close --terminal %s で閉じる）"
                 % (stopped_at(handle, home, email, why), retry, handle))
    # 席を読んでから端末ができるまでに席が切り替わると、この端末は古い席で起きている。Task を渡す前に閉じて打ち直させる。
    if a.agent == "claude" and seat()[0] != home:
        orca("terminal", "close", "--terminal", handle)
        sys.exit("orca-launch: 起動の途中で Claude の席が切り替わったので、Task を渡さずに端末を閉じた。同じ orca-launch を打ち直す")

    started = orca(*args)
    r = started.get("result") or {}
    print(json.dumps({k: r.get(k) for k in ("runId", "taskId", "dispatchId", "terminal", "state", "failedStage", "lastError")
                      if r.get(k)}, ensure_ascii=False))
    sys.exit(0 if started.get("ok") else 1)


if __name__ == "__main__":
    main()
