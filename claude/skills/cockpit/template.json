      "goal": "<なんのため。1 文>",
      "next": "<次にやること。1 文>",
      "done": [{ "text": "<ここまでに済んだこと>", "at": "2026-11-16T18:30:00+09:00" }],
      "sources": ["docs/design/screens.md"],
      "worker": {
        "run_id": "<orca-launch か worker-start の受け取りの runId>",
        "task_id": "<同じ受け取りの taskId。続きを頼んでも書き換えない>"
      },
      "repo": "<owner/name。#123 を PR のリンクにする>"
    },
    {
      "id": "t2",
      "stream": "s1",
      "phase": "決定",
      "title": "<外の相手を待つタスク>",
      "state": "open",
      "wait": { "kind": "person", "who": "先方の担当者", "what": "認証情報", "since": "2026-11-17" },
      "next": "届いたら、12/1 の週に検証環境へ入れる日程を確定する"
    },
    {
      "id": "t3",
      "stream": "s1",
      "phase": "確認",
      "title": "<日付が来たら見直すタスク>",
      "state": "open",
      "wait": { "kind": "date", "on": "2026-12-04", "what": "通知が出たかを確認する" },
      "after": ["t2"],
      "next": "出ていなければ、設定を見直すタスクを起こす"
    }
  ],
  "owners": [
    {
      "id": "o1",
      "title": "<仕事の名前。s1 と同じ>",
