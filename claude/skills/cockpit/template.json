      "summary": "a-desk が管理表と Slack の新着を定期確認し、気づいたことを窓口に送る",
      "watch": {
        "automation": "<orca automations の id。例: auto_adesk01>",
        "targets": ["管理表『運用保守対応』", "Slack 7 チャンネル"],
        "to": "Main · sample-app"
      }
    }
  ],
  "tasks": [
    {
      "id": "t1",
      "stream": "s1",
      "phase": "決定",
      "title": "<タスク名。20 字以内の名詞句>",
