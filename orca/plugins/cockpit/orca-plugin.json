{
  "manifestVersion": 2,
  "id": "cockpit",
  "name": "操縦席",
  "version": "0.1.0",
  "description": "ワークスペースのメインのエージェントが書く .orca/cockpit.json を、あなたの残・全体・片付け済みで見せ、判断を記録する。",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "cockpit",
        "title": "操縦席",
        "icon": "gauge",
        "entry": "src/panel.ts",
        "ui": "html"
      }
    ],
    "events": [
      { "on": "workspace.changed" },
      { "on": "agent.status.changed" }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "terminal:send" },
    { "kind": "workspace:write" },
    { "kind": "storage:own" }
  ]
}
