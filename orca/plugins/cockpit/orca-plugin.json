{
  "manifestVersion": 2,
  "id": "cockpit",
  "name": "操縦席",
  "version": "0.1.0",
  "description": "全案件の「私の番」を期限順に並べ、決める・送る・許す・見るをその場で返し、担当のチャットへ渡す。",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "cockpit",
        "title": "操縦席",
        "icon": "gauge",
        "entry": "src/panel.ts",
        "ui": "html"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      },
      {
        "on": "agent.status.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "mine",
        "text": "私の番",
        "icon": "gauge",
        "tooltip": "前面の案件の私の番",
        "command": "cockpit.show"
      }
    ],
    "commands": [
      {
        "id": "cockpit.show",
        "title": "操縦席: 右のサイドバーを開く",
        "action": "sidebar.right.toggle"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "storage:own"
    }
  ]
}
